<script>
  // EDITION ENGINE: the redaction that cycles what was inside; the habit loop
  // (auto-advances until you take over); the range (sway, breath, decimal scoring);
  // the rules deck; stderr tailing what you do; the folio clock; today's coffee.
  (function () {
    'use strict';
    try {
      const edition = document.getElementById('about');
      if (!edition) return;
      const REDUCE = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let visible = false;
      new IntersectionObserver((es) => es.forEach((en) => { visible = en.isIntersecting; if (visible) wake(); }), { rootMargin: '80px 0px' }).observe(edition);

      /* ---------- stderr ---------- */
      const log = document.getElementById('stderr-log');
      let lastSay = 0;
      // stderr's mood, 10 = deeply unimpressed. Things that would impress a cat wear
      // it down; being left alone builds it back up.
      const moodBars = Array.from(document.querySelectorAll<HTMLElement>('.sd-bar i'));
      const moodV = document.getElementById('sd-mood');
      let mood = 9;
      function setMood(d: number) {
        mood = Math.max(0, Math.min(10, mood + d));
        moodBars.forEach((b, i) => b.classList.toggle('on', i < mood));
        if (moodV) moodV.textContent = mood >= 8 ? 'UNIMPRESSED' : mood >= 5 ? 'MILDLY CURIOUS' : mood >= 2 ? 'INTRIGUED' : '...IMPRESSED';
      }
      setMood(0);
      function say(line: string, force = false) {
        if (!log) return;
        const now = performance.now();
        if (!force && now - lastSay < 1400) return;
        lastSay = now;
        const ln = document.createElement('span');
        ln.className = 'ln';
        ln.textContent = '> ' + line;
        log.appendChild(ln);
        while (log.children.length > 6) log.removeChild(log.firstChild as Node);
      }
      const IDLE = ['still here. still unimpressed.', 'you scroll like you mean it.', 'saw your TODO list. bold of you.', 'it compiles. doesn’t mean it’s good.', 'i was asleep for the tests. they still passed.'];
      let idleI = 0;
      setInterval(() => { if (visible && performance.now() - lastSay > 9000) { say(IDLE[idleI++ % IDLE.length]); setMood(1); } }, 3000);

      /* ---------- folio clock + today's coffee ---------- */
      const clock = document.getElementById('ed-clock');
      const cups = document.getElementById('cups');
      const fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false, timeZone: 'Asia/Kolkata' });
      function tick() {
        if (!visible && clock && clock.textContent !== '--:--:--') return;
        const t = fmt.format(new Date());
        if (clock) clock.textContent = t;
        if (cups) {
          const h = parseInt(t.slice(0, 2), 10);
          cups.textContent = String(h < 7 ? 0 : h < 11 ? 1 : h < 15 ? 2 : h < 19 ? 3 : 4); // a Bengaluru filter-coffee schedule
        }
      }
      tick();
      setInterval(tick, 1000);

      /* ---------- the redaction ---------- */
      const redact = document.getElementById('redact');
      const redIn = document.getElementById('redact-in');
      const OPENED = ['neural nets', 'GPT-2', 'git', 'consensus', 'RAG errors', 'probes'];
      let ri = 0, rTimer = 0;
      function nextOpened() {
        if (!redIn) return;
        ri = (ri + 1) % OPENED.length;
        redIn.textContent = OPENED[ri];
      }
      function openRedact() {
        if (!redact || rTimer) return;
        redact.classList.add('is-open');
        say('declassified. ' + OPENED[ri] + '.', true);
        setMood(-1);
        rTimer = window.setInterval(nextOpened, 900);
      }
      function closeRedact() {
        if (!redact) return;
        redact.classList.remove('is-open');
        window.clearInterval(rTimer); rTimer = 0;
      }
      if (redact) {
        redact.addEventListener('pointerenter', openRedact);
        redact.addEventListener('pointerleave', closeRedact);
        redact.addEventListener('focus', openRedact);
        redact.addEventListener('blur', closeRedact);
        redact.addEventListener('click', () => (redact.classList.contains('is-open') ? closeRedact() : openRedact()));
      }

      /* ---------- the habit loop ---------- */
      const steps = Array.from(edition.querySelectorAll<HTMLElement>('.step'));
      const QUIPS = ['a planner. for the planning. sure.', 'backprop by hand. nobody asked.', 'rebuilt git. for fun. allegedly.', 'disproved himself. on purpose.'];
      let cur = 0, held = false, auto = 0;
      steps.forEach((s) => s.querySelectorAll<HTMLElement>('.v-tests i').forEach((t, j) => t.style.setProperty('--d', String(j * 0.08))));
      function setStep(i: number, talk: boolean) {
        cur = i;
        steps.forEach((s, j) => s.classList.toggle('is-on', j === i));
        if (talk) say(QUIPS[i]);
        if (i === 2) scrambleHash();
      }
      steps.forEach((s, i) => {
        s.addEventListener('pointerenter', () => { held = true; setStep(i, true); });
        s.addEventListener('focus', () => { held = true; setStep(i, true); });
      });
      const habit = document.getElementById('habit');
      if (habit) habit.addEventListener('pointerleave', () => { held = false; });
      function wake() {
        if (auto || REDUCE) return;
        auto = window.setInterval(() => { if (visible && !held) setStep((cur + 1) % steps.length, false); }, 2600);
      }
      // the commit hash re-resolves each time step 03 comes on
      const hashEl = edition.querySelector<HTMLElement>('[data-hash]');
      function scrambleHash() {
        if (!hashEl || REDUCE) return;
        const HEX = '0123456789abcdef';
        let fin = '';
        for (let i = 0; i < 16; i++) fin += HEX[(Math.random() * 16) | 0];
        const t0 = performance.now();
        const run = (now: number) => {
          const k = Math.min(1, Math.max(0, (now - t0) / 700)), rev = Math.floor(k * 16);
          let out = '';
          for (let i = 0; i < 16; i++) out += i < rev ? fin[i] : HEX[(Math.random() * 16) | 0];
          hashEl.textContent = out;
          if (k < 1) requestAnimationFrame(run);
        };
        requestAnimationFrame(run);
      }

      /* ---------- house rules: deal the top card to the back ---------- */
      const deck = document.getElementById('rules');
      if (deck) {
        const cards = Array.from(deck.querySelectorAll<HTMLElement>('.rule-card'));
        let order = cards.map((_, i) => i);
        const place = () => order.forEach((ci, pos) => cards[ci].style.setProperty('--o', String(pos)));
        place();
        let busy = false;
        const RULE_QUIPS = ['rule acknowledged. ignored.', 'local-first. the cloud is someone else’s cat.', 'why it fails. deep.', 'nothing boring here. except you.'];
        deck.addEventListener('click', () => {
          if (busy) return;
          busy = true;
          const top = cards[order[0]];
          say(RULE_QUIPS[order[0]]);
          setMood(-1);
          top.classList.add('is-out');
          window.setTimeout(() => {
            order = order.slice(1).concat(order[0]);
            top.classList.remove('is-out');
            place();
            busy = false;
          }, REDUCE ? 0 : 340);
        });
      }

      /* ---------- the range ---------- */
      const cv = document.getElementById('range-cv') as HTMLCanvasElement | null;
      const ctx = cv?.getContext('2d');
      const lastEl = document.getElementById('rr-last');
      const totEl = document.getElementById('rr-total');
      const nEl = document.getElementById('rr-n');
      if (cv && ctx) {
        // the ISSF 10m air rifle target, in millimetres: ring n's outer radius is
        // 0.25 + (10 - n) * 2.5; the black aiming mark covers rings 4 to 9
        const RING1 = 22.75, BLACK = 15.25, PELLET = 2.25;
        let S = 1, W = 1; // css px per mm, canvas css width
        const dpr = Math.min(2, window.devicePixelRatio || 1);
        function size() {
          const r = cv!.getBoundingClientRect();
          if (r.width < 1) return;
          W = r.width;
          cv!.width = Math.round(W * dpr); cv!.height = Math.round(W * dpr);
          ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
          S = (W / 2) / (RING1 + 3);
          draw();
        }
        let aimX = 0, aimY = 0, inside = false; // mm, relative to the centre
        let swayX = 0, swayY = 0, still = 0, t = 0, kick = 0;
        const shots: { x: number; y: number; s: number }[] = [];
        let raf = 0, lastT = 0;
        function score(x: number, y: number) {
          const d = Math.max(0, Math.hypot(x, y) - PELLET); // the pellet's edge counts
          const s = 10.9 - d / 2.5;
          return s < 1 ? 0 : Math.floor(s * 10) / 10;
        }
        function draw() {
          const c = ctx!, C = W / 2;
          c.clearRect(0, 0, W, W);
          c.fillStyle = '#e9e4d8'; c.fillRect(0, 0, W, W);
          c.save(); c.translate(C, C);
          c.fillStyle = '#f7f5f1'; c.beginPath(); c.arc(0, 0, RING1 * S, 0, 7); c.fill();
          c.fillStyle = '#141414'; c.beginPath(); c.arc(0, 0, BLACK * S, 0, 7); c.fill();
          for (let n = 1; n <= 10; n++) {
            const r = (0.25 + (10 - n) * 2.5) * S;
            c.strokeStyle = r <= BLACK * S + 0.5 ? 'rgba(247,245,241,0.55)' : 'rgba(20,20,20,0.55)';
            c.lineWidth = 1;
            c.beginPath(); c.arc(0, 0, Math.max(0.6, r), 0, 7); c.stroke();
          }
          c.fillStyle = '#f7f5f1'; c.beginPath(); c.arc(0, 0, Math.max(1.2, 0.25 * S), 0, 7); c.fill();
          // shots
          shots.forEach((s, i) => {
            const last = i === shots.length - 1;
            c.fillStyle = last ? '#ed1c24' : '#b4ff2e';
            c.strokeStyle = '#141414'; c.lineWidth = 1.2;
            c.beginPath(); c.arc(s.x * S, s.y * S, PELLET * S, 0, 7); c.fill(); c.stroke();
          });
          // reticle
          if (inside) {
            const rx = (aimX + swayX) * S, ry = (aimY + swayY) * S + kick;
            c.strokeStyle = '#ed1c24'; c.lineWidth = 2;
            c.beginPath(); c.arc(rx, ry, 4.2 * S, 0, 7); c.stroke();
            c.beginPath();
            c.moveTo(rx - 7 * S, ry); c.lineTo(rx - 2 * S, ry); c.moveTo(rx + 2 * S, ry); c.lineTo(rx + 7 * S, ry);
            c.moveTo(rx, ry - 7 * S); c.lineTo(rx, ry - 2 * S); c.moveTo(rx, ry + 2 * S); c.lineTo(rx, ry + 7 * S);
            c.stroke();
            // breath meter: how steady you are
            const steady = Math.min(1, still / 1.4);
            c.fillStyle = 'rgba(20,20,20,0.15)'; c.fillRect(-C + 10, C - 16, 70, 5);
            c.fillStyle = steady > 0.95 ? '#7bbf00' : '#ed1c24'; c.fillRect(-C + 10, C - 16, 70 * steady, 5);
            c.fillStyle = '#141414'; c.font = '700 8px "Martian Mono", monospace'; c.fillText(steady > 0.95 ? 'STEADY' : 'BREATHE', -C + 86, C - 11);
          }
          c.restore();
        }
        function frame(now: number) {
          const dt = lastT ? Math.max(0, Math.min(0.05, (now - lastT) / 1000)) : 0;
          lastT = now; t += dt;
          still += dt;
          // sway: a slow breath plus a wander, shrinking as you hold still
          // (no hold is perfectly still: the floor is about a 10.0 at best on average)
          const amp = REDUCE ? 0 : 1.5 + 4.4 * Math.max(0, 1 - still / 1.4);
          swayX = Math.sin(t * 1.3) * amp * 0.5 + Math.sin(t * 3.7 + 1.1) * amp * 0.3 + Math.sin(t * 7.9 + 2.3) * amp * 0.2;
          swayY = Math.cos(t * 0.9) * amp * 0.6 + Math.sin(t * 2.3) * amp * 0.25 + Math.cos(t * 6.1 + 0.7) * amp * 0.15;
          kick *= 0.82;
          draw();
          if (inside && visible) raf = requestAnimationFrame(frame); else { raf = 0; lastT = 0; }
        }
        function startRange() { if (!raf) raf = requestAnimationFrame(frame); }
        function aimFrom(e: PointerEvent) {
          const r = cv!.getBoundingClientRect();
          const nx = (e.clientX - r.left - W / 2) / S, ny = (e.clientY - r.top - W / 2) / S;
          if (Math.hypot(nx - aimX, ny - aimY) > 0.6) still = Math.min(still, 0.15);
          aimX = nx; aimY = ny;
        }
        cv.addEventListener('pointerenter', (e) => { inside = true; still = 0; aimFrom(e); startRange(); });
        cv.addEventListener('pointermove', (e) => { aimFrom(e); });
        cv.addEventListener('pointerleave', () => { inside = false; draw(); });
        cv.addEventListener('pointerdown', (e) => {
          e.preventDefault();
          inside = true; aimFrom(e); startRange();
          // the trigger pull itself flinches the shot a little
          const fl = REDUCE ? 0 : 0.9, fa = Math.random() * Math.PI * 2, fr = Math.random() * fl;
          const x = aimX + swayX + Math.cos(fa) * fr, y = aimY + swayY + Math.sin(fa) * fr;
          if (shots.length >= 10) shots.length = 0;
          const s = score(x, y);
          shots.push({ x, y, s });
          kick = -10; still = 0;
          const total = shots.reduce((a, b) => a + b.s, 0);
          if (lastEl) lastEl.textContent = s.toFixed(1);
          if (totEl) totEl.textContent = total.toFixed(1);
          if (nEl) nEl.textContent = shots.length + '/10';
          say(s >= 10.5 ? s.toFixed(1) + '. show-off.' : s >= 10 ? s.toFixed(1) + '. fine. that’s a ten.' : s >= 9 ? s.toFixed(1) + '. breathe out first.' : s > 0 ? s.toFixed(1) + '. the printer shoots better.' : 'miss. the target is the round thing.', true);
          setMood(s >= 10 ? -2 : s >= 9 ? 0 : 1);
          if (shots.length === 10) say('series: ' + total.toFixed(1) + ' / 109.0. ' + (total > 100 ? 'okay. that’s good.' : 'he shoots 10s at nationals. just saying.'), true);
        });
        size();
        if (typeof ResizeObserver !== 'undefined') new ResizeObserver(size).observe(cv);
      }
    } catch (e) { /* edition engine failed silently */ }
  })();

  // FIG. 1: the black box, drawn as pixel art on a 64-pixel grid so it reads in
  // the same hand as the portrait. Flat, with the site's hard offset shadow and a
  // halftone shadow on the floor. Its lid flips open on a loop and the things
  // inside pop out as tags; while the headline's box is open, the figure holds
  // open and lets out the same word. Draws only while on screen.
  (function () {
    'use strict';
    try {
      const cv = document.getElementById('box-cv') as HTMLCanvasElement | null;
      const ctx = cv?.getContext('2d');
      const redact = document.getElementById('redact');
      const redIn = document.getElementById('redact-in');
      if (!cv || !ctx) return;
      const REDUCE = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const ITEMS = ['NEURAL NETS', 'GPT-2', 'GIT', 'CONSENSUS', 'RAG ERRORS', 'PROBES', 'SAE FEATURES', 'ROUGE-L', 'AGENTS.MD'];
      const G = 64; // the art's own pixel grid
      const px = new Uint8ClampedArray(G * G * 4);
      const buf = document.createElement('canvas'); buf.width = G; buf.height = G;
      const bctx = buf.getContext('2d'); if (!bctx) return;
      const img = bctx.createImageData(G, G);
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      let W = 1, S = 4, OX = 0, OY = 0;
      function size() {
        const r = cv!.getBoundingClientRect(); if (r.width < 1) return;
        W = r.width; cv!.width = Math.round(W * dpr); cv!.height = Math.round(W * dpr);
        ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
        S = Math.max(2, Math.floor(W / G)); OX = Math.round((W - G * S) / 2); OY = Math.round((W - G * S) / 2);
      }
      const hex = (h: string) => [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)];
      const INK = hex('#141414'), INK2 = hex('#2c2c2c'), RED = hex('#ed1c24'), LIME = hex('#b4ff2e'), CREAM = hex('#f7f5f1'), DARK = hex('#050505');
      function set(x: number, y: number, c: number[]) {
        x |= 0; y |= 0; if (x < 0 || y < 0 || x >= G || y >= G) return;
        const i = (y * G + x) * 4; px[i] = c[0]; px[i + 1] = c[1]; px[i + 2] = c[2]; px[i + 3] = 255;
      }
      function rect(x: number, y: number, w: number, h: number, c: number[]) { for (let j = 0; j < h; j++) for (let i = 0; i < w; i++) set(x + i, y + j, c); }
      // a convex quad, filled pixel by pixel (no anti-aliasing: it stays pixel art)
      function quad(p: number[][], c: number[]) {
        const xs = p.map((q) => q[0]), ys = p.map((q) => q[1]);
        for (let y = Math.floor(Math.min(...ys)); y <= Math.ceil(Math.max(...ys)); y++)
          for (let x = Math.floor(Math.min(...xs)); x <= Math.ceil(Math.max(...xs)); x++) {
            const cx = x + 0.5, cy = y + 0.5; let inside = true;
            for (let k = 0; k < 4; k++) {
              const a = p[k], b = p[(k + 1) % 4];
              if ((b[0] - a[0]) * (cy - a[1]) - (b[1] - a[1]) * (cx - a[0]) < 0) { inside = false; break; }
            }
            if (inside) set(x, y, c);
          }
      }
      interface Tag { t: string; age: number; dir: number; rot: number; hot: boolean; }
      const tags: Tag[] = [];
      let clk = 0, lid = 0, lastT = 0, raf = 0, visible = false, next = 0, ii = 0, hover = false, lastWord = '', side = 1;
      function spawn(word: string | undefined, hot: boolean) {
        side = -side;
        tags.push({ t: (word || ITEMS[ii++ % ITEMS.length]).toUpperCase(), age: 0, dir: side * (0.35 + Math.random() * 0.4), rot: side * (0.04 + Math.random() * 0.08), hot });
        if (tags.length > 4) tags.shift();
      }
      // body and lid geometry, in grid pixels
      const BX = 15, BY = 33, BW = 34, BH = 22;
      function paint(t: number) {
        px.fill(0);
        const closedShiver = lid < 0.05 && t > 0.4 && t < 1.1 && Math.floor(t * 18) % 2 === 0 ? 1 : 0;
        const bx = BX + closedShiver;
        // halftone floor shadow: denser at the centre, like the dots behind the portrait
        for (let y = BY + BH + 3; y < BY + BH + 9; y++)
          for (let x = bx - 6; x < bx + BW + 9; x++) {
            const dx = (x - (bx + BW / 2 + 2)) / (BW * 0.75), dy = (y - (BY + BH + 5.5)) / 3.6, d = dx * dx + dy * dy;
            if (d > 1) continue;
            const on = d < 0.25 ? (x + y) % 2 === 0 : d < 0.6 ? x % 2 === 0 && y % 2 === 0 : x % 3 === 0 && y % 2 === 0;
            if (on) set(x, y, RED);
          }
        // the hard offset shadow every card on the site carries
        rect(bx + 3, BY + 3, BW, BH, RED);
        // the body: ink, a lighter top band, lime rivets, a strap of red tape
        rect(bx, BY, BW, BH, INK);
        rect(bx, BY, BW, 2, INK2);
        rect(bx + 1, BY + 4, BW - 2, 1, DARK);
        [[bx + 1, BY + 1], [bx + BW - 2, BY + 1], [bx + 1, BY + BH - 2], [bx + BW - 2, BY + BH - 2]].forEach((q) => set(q[0], q[1], LIME));
        rect(bx + BW - 8, BY, 3, BH, RED);
        // the opening, once the lid is up: dark, with lime motes rising out
        const a = lid * 1.8; // lid angle: up to about 100 degrees, leaning back
        if (lid > 0.08) {
          rect(bx + 1, BY - 1, BW - 2, 2, DARK);
          for (let k = 0; k < 10; k++) {
            const ph = (clk * 1.4 + k * 0.37) % 1;
            const mx = bx + 3 + ((k * 7 + Math.floor(clk * 3) * 3) % (BW - 6)), my = BY - 2 - Math.floor(ph * 12 * lid);
            if (ph < 0.9) set(mx, my, LIME);
          }
        }
        // the lid hinges at the back-left corner of the opening
        const hx = bx - 1, hy = BY, L = BW + 2, T = 4;
        const c = Math.cos(-a), sn = Math.sin(-a);
        const rot = (x: number, y: number) => [hx + x * c - y * sn, hy + x * sn + y * c];
        const lidPts = [rot(0, -T), rot(L, -T), rot(L, 0), rot(0, 0)];
        quad(lidPts.map((q) => [q[0] + 2, q[1] + 2]), RED); // its own hard shadow
        quad(lidPts, INK);
        const rim = [rot(0, -T), rot(L, -T), rot(L, -T + 1), rot(0, -T + 1)];
        quad(rim, INK2);
        const tape = [rot(L - 8, -T), rot(L - 5, -T), rot(L - 5, 0), rot(L - 8, 0)];
        quad(tape, RED);
        img.data.set(px);
        bctx!.putImageData(img, 0, 0);
      }
      function draw(t: number) {
        const c = ctx!;
        c.clearRect(0, 0, W, W);
        paint(t);
        c.imageSmoothingEnabled = false;
        c.drawImage(buf, OX, OY, G * S, G * S);
        // the stencil, set in the pixel face so it sits on the art's grid
        c.font = (S * 4) + 'px "Silkscreen", monospace';
        c.textAlign = 'center'; c.textBaseline = 'middle';
        c.fillStyle = '#ed1c24';
        c.fillText('DO NOT', OX + (BX + BW / 2 - 4) * S, OY + (BY + 9) * S);
        c.fillText('OPEN', OX + (BX + BW / 2 - 4) * S, OY + (BY + 15) * S);
        // tags popping out: cream chips with ink borders and hard shadows, like the site's
        const ox = OX + (BX + BW / 2) * S, oy = OY + (BY - 2) * S;
        c.font = Math.max(9, Math.round(S * 2.6)) + 'px "Silkscreen", monospace';
        for (let i = tags.length - 1; i >= 0; i--) {
          const g = tags[i]; const k = g.age / 2.4;
          if (k >= 1) { tags.splice(i, 1); continue; }
          const e = 1 - Math.pow(1 - Math.min(1, k * 1.6), 3);
          const x = ox + g.dir * e * W * 0.36, y = oy - e * W * 0.36 + Math.pow(Math.max(0, k - 0.6), 2) * W * 0.2;
          const alpha = k < 0.08 ? k / 0.08 : k > 0.82 ? (1 - k) / 0.18 : 1;
          const tw = c.measureText(g.t).width + 16, th = S * 5.4;
          c.save(); c.globalAlpha = alpha; c.translate(Math.round(x), Math.round(y)); c.rotate(g.rot);
          c.fillStyle = '#141414'; c.fillRect(-tw / 2 + 4, -th / 2 + 4, tw, th);
          c.fillStyle = g.hot ? '#b4ff2e' : '#f7f5f1'; c.fillRect(-tw / 2, -th / 2, tw, th);
          c.strokeStyle = '#141414'; c.lineWidth = 2; c.strokeRect(-tw / 2 + 1, -th / 2 + 1, tw - 2, th - 2);
          c.fillStyle = '#141414'; c.textAlign = 'center'; c.textBaseline = 'middle'; c.fillText(g.t, 0, 1);
          c.restore();
        }
      }
      function frame(now: number) {
        const dt = lastT ? Math.max(0, Math.min(0.05, (now - lastT) / 1000)) : 0; lastT = now;
        if (!(window as any).__pressFreeze) {
          clk += dt;
          tags.forEach((g) => { g.age += dt; });
          const held = !!redact && redact.classList.contains('is-open');
          const t = clk % 5.4;
          const target = held || hover ? 1 : t < 1.3 ? 0 : t < 4.7 ? 1 : 0;
          // the lid snaps: fast up with a little overshoot, a thump down
          lid += (target - lid) * Math.min(1, dt * (target > lid ? 9 : 7));
          if (lid > 0.75) {
            next -= dt;
            const w = held && redIn ? (redIn.textContent || '') : '';
            if (w && w !== lastWord) { spawn(w, true); lastWord = w; next = 0.8; }
            else if (next <= 0) { spawn(undefined, false); next = hover ? 0.5 : 0.95; }
          }
          draw(t);
        }
        if (visible) raf = requestAnimationFrame(frame); else { raf = 0; lastT = 0; }
      }
      function start() { if (!raf && visible) raf = requestAnimationFrame(frame); }
      cv.addEventListener('pointerenter', () => { hover = true; });
      cv.addEventListener('pointerleave', () => { hover = false; });
      if (typeof ResizeObserver !== 'undefined') new ResizeObserver(() => { size(); if (!raf) draw(0); }).observe(cv);
      size();
      if (REDUCE) { lid = 1; spawn(undefined, false); tags[0].age = 0.9; draw(2); return; }
      new IntersectionObserver((es) => es.forEach((en) => { visible = en.isIntersecting; start(); })).observe(cv);
    } catch (e) { /* the figure stays blank */ }
  })();
</script>
