---
import { site } from '../data/site';
const year = new Date().getFullYear(); // colophon stays current per build

/* The about page, said in as few words as it can take: one headline you can
   open, the habit behind every project as a four-step loop, and three
   things to play with instead of paragraphs to read. */
const steps = [
  {
    n: '01', k: 'ANNOYED', line: 'Something bugs me, or I can’t see how it works.',
    eg: 'Spent more time planning to study than studying.',
    chips: [['Orbit', '/projects/orbit']],
  },
  {
    n: '02', k: 'OPEN IT', line: 'Go one layer deeper than I need to.',
    eg: 'Backprop by hand. Then watch GPT-2 think.',
    chips: [['Gradient', '/projects/gradient'], ['GlassBox', '/projects/glassbox']],
  },
  {
    n: '03', k: 'REBUILD IT', line: 'If I can’t rebuild it, I don’t understand it.',
    eg: 'Git in C. A sharded KV store in Rust.',
    chips: [['PES-VCS', '/projects/pes-vcs'], ['Tessera', '/projects/tessera']],
  },
  {
    n: '04', k: 'PROVE IT', line: 'Then check whether it’s true, not just whether it runs.',
    eg: 'Grade the tools the field trusts.',
    chips: [['Research desk', '/#research']],
  },
];

const rules = [
  ['If I can’t rebuild it,', 'I don’t understand it.'],
  ['Local-first by default.', 'Your data, your GPU, no server.'],
  ['Whether it works is easy.', 'Why it fails is the work.'],
  ['Boring is the one thing', 'I refuse to ship.'],
];

const opened = ['neural nets', 'GPT-2', 'git', 'consensus', 'RAG errors', 'probes'];
---

<!-- EDITION (rises over the sticky hero) — the about section -->
<section class="edition" id="about">
  <div class="page">

    <div class="folio">
      <span>VOL. PES1UG24CS127 &middot; <b>FRONT PAGE</b></span>
      <span class="folio-c">PRICE: ONE FILTER COFFEE</span>
      <span>BENGALURU &middot; <span id="ed-clock">--:--:--</span> IST</span>
    </div>

    <header class="masthead">
      <hr class="mast-rule" />
      <div class="masthead-row">
        <svg class="mast-emblem" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <ellipse cx="12" cy="12" rx="10.6" ry="3.9" transform="rotate(-26 12 12)" stroke="currentColor" stroke-width="1.7"></ellipse>
          <circle cx="12" cy="12" r="3" fill="currentColor"></circle>
          <circle cx="3.7" cy="16.1" r="1.7" fill="currentColor"></circle>
        </svg>
        <span class="masthead-title">THE DAILY CHEETHIRALA</span>
        <span class="mast-ear" aria-hidden="true">ALL THE BUGS<br />FIT TO PRINT</span>
      </div>
      <div class="ticker" aria-hidden="true">
        <span class="ticker-flag"><span class="blip"></span>BREAKING</span>
        <div class="ticker-viewport">
          <div class="ticker-track">
            <span class="tk">AREA MAN REBUILDS GIT FOR NO REASON<i>&#10022;</i>NEURAL NET TRAINED IN BROWSER; SERVER NOT INVITED<i>&#10022;</i>GPT-2 SEEN THINKING<i>&#10022;</i><b>INTERNING @ PESU I-LABS &middot; OPEN FOR SUMMER 2027</b><i>&#10022;</i>STDERR: &ldquo;approved. reluctantly.&rdquo;<i>&#10022;</i></span>
            <span class="tk">AREA MAN REBUILDS GIT FOR NO REASON<i>&#10022;</i>NEURAL NET TRAINED IN BROWSER; SERVER NOT INVITED<i>&#10022;</i>GPT-2 SEEN THINKING<i>&#10022;</i><b>INTERNING @ PESU I-LABS &middot; OPEN FOR SUMMER 2027</b><i>&#10022;</i>STDERR: &ldquo;approved. reluctantly.&rdquo;<i>&#10022;</i></span>
          </div>
        </div>
      </div>
    </header>

    <!-- ===================== THE LEAD ===================== -->
    <div class="lead">
      <div class="lead-main">
        <span class="kicker">&#9654; ABOUT &middot; CS @ PES UNIVERSITY &middot; SWE / ML</span>
        <h2 class="headline">
          <span class="hl-line">I open</span>
          <span class="hl-line"><span class="box" id="redact" tabindex="0" role="button" aria-label="Open the black box to see what was inside">
            <span class="box-in" aria-hidden="true"><span id="redact-in">{opened[0]}</span></span>
            <span class="box-lid">black boxes</span>
            <span class="box-tag" aria-hidden="true">open me</span>
          </span>.</span>
        </h2>
        <p class="deck">If I can&rsquo;t see how something works, I build my own until I can.</p>
        <div class="chips">
          <span class="chip chip--live"><i></i>Interning @ PESU I-Labs</span>
          <span class="chip">Open to Summer 2027</span>
          <span class="chip">Bengaluru &middot; he/him</span>
        </div>
      </div>
      <figure class="lead-art" aria-hidden="true">
        <canvas id="box-cv"></canvas>
        <figcaption>FIG. 1 &middot; A BLACK BOX, OPENED</figcaption>
      </figure>
      <div class="lead-side" aria-label="By the numbers">
        <div class="num"><b data-count="97%">97%</b><span>MNIST, backprop by hand, no framework</span></div>
        <div class="num"><b data-count="3">3</b><span>papers under review</span></div>
        <div class="num"><b data-count="16">16</b><span>things built to understand them</span></div>
        <div class="num"><b id="cups">2</b><span>filter coffees so far today</span></div>
      </div>
    </div>

    <!-- ===================== THE HABIT ===================== -->
    <div class="habit" id="habit">
      <div class="sec-h"><span>THE HABIT</span><span class="sec-s">every project starts the same way &middot; hover a step</span></div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class={`step step-${i + 1}${i === 0 ? ' is-on' : ''}`} data-step={i} tabindex="0">
            <div class="step-top"><span class="step-n">{s.n}</span><span class="step-arrow" aria-hidden="true">{i < 3 ? '→' : '↺'}</span></div>
            <div class="step-viz" aria-hidden="true">
              {i === 0 && (
                <svg viewBox="0 0 160 70" class="v-curve">
                  <path class="axis" d="M6 64 H154 M6 64 V6" />
                  <path class="decay" d="M6 10 C 30 46, 46 52, 58 54 L58 14 C 78 40, 92 46, 104 48 L104 16 C 122 34, 140 40, 154 42" pathLength="100" />
                  <path class="thr" d="M6 38 H154" />
                </svg>
              )}
              {i === 1 && (
                <svg viewBox="0 0 160 70" class="v-net">
                  {[16, 35, 54].map((y) => [14, 30, 46].map((y2) => <line x1="22" y1={y} x2="80" y2={y2 + 4} />))}
                  {[18, 34, 50].map((y) => <line x1="80" y1={y} x2="138" y2="35" />)}
                  {[16, 35, 54].map((y) => <circle cx="22" cy={y} r="5" />)}
                  {[18, 34, 50].map((y) => <circle cx="80" cy={y} r="5" />)}
                  <circle cx="138" cy="35" r="6" class="out" />
                </svg>
                <svg viewBox="0 0 160 70" class="v-net v-pulses">
                  <circle r="2.6" class="pulse p1" />
                  <circle r="2.6" class="pulse p2" />
                </svg>
              )}
              {i === 2 && (
                <div class="v-hash">
                  <span class="hash" data-hash>e3b0c44298fc1c14</span>
                  <span class="dag"><i></i><b></b><i></i><b></b><i class="head"></i></span>
                </div>
              )}
              {i === 3 && (
                <div class="v-tests">
                  {Array.from({ length: 10 }, (_, t) => <i class={t === 6 ? 'bad' : ''}></i>)}
                  <span class="v-tests-l"><b>9/10 pass</b> &middot; the one that didn&rsquo;t is the paper</span>
                </div>
              )}
            </div>
            <div class="step-k">{s.k}</div>
            <p class="step-line">{s.line}</p>
            <p class="step-eg">{s.eg}</p>
            <div class="step-chips">
              {s.chips.map(([label, href]) => <a class="to" href={href}>{label} <span aria-hidden="true">&#8599;</span></a>)}
            </div>
          </li>
        ))}
      </ol>
    </div>

    <!-- ===================== OFF THE CLOCK ===================== -->
    <div class="bento">
      <!-- 10m air rifle -->
      <figure class="tile tile-range" id="range">
        <div class="tile-h"><span>10M AIR RIFLE</span><span class="tile-s">national level</span></div>
        <div class="range-stage">
          <canvas class="range-cv" id="range-cv" aria-label="Shooting range: move to aim, click to fire" role="img"></canvas>
          <div class="range-read" aria-live="polite">
            <span class="rr-k">LAST</span><b class="rr-v" id="rr-last">&mdash;</b>
            <span class="rr-k">SERIES</span><b class="rr-v" id="rr-total">0.0</b>
            <span class="rr-k">SHOTS</span><b class="rr-v" id="rr-n">0/10</b>
          </div>
        </div>
        <figcaption class="tile-cap">Hold still. Breathe out. Click.</figcaption>
      </figure>

      <!-- house rules: a deck you can deal -->
      <div class="tile tile-rules">
        <div class="tile-h"><span>HOUSE RULES</span><span class="tile-s">click to deal</span></div>
        <button class="deck-stack" id="rules" type="button" aria-label="Next house rule">
          {rules.map(([a, b], i) => (
            <span class="rule-card" style={`--i:${i}`} data-rule={i}>
              <span class="rule-big" aria-hidden="true">{i + 1}</span>
              <span class="rule-n">HOUSE RULE No.{i + 1}</span>
              <span class="rule-a">{a}</span>
              <span class="rule-b">{b}</span>
              <span class="rule-foot" aria-hidden="true"><span>{i + 1} / {rules.length}</span><span>DEAL &#8635;</span></span>
            </span>
          ))}
        </button>
      </div>

      <!-- stderr, the cat, tailing the reader -->
      <div class="tile tile-stderr">
        <div class="tile-h"><span>STDERR &middot; LIVE</span><span class="tile-s">editor, unpaid</span></div>
        <div class="stderr-head">
          <span class="stderr-face" aria-hidden="true"></span>
          <span class="stderr-who">the cat on my shoulder.<br />reviews commits. remains unimpressed.</span>
        </div>
        <div class="sd-mood" aria-label="stderr's mood">
          <span class="sd-mood-k">MOOD</span>
          <span class="sd-bar" aria-hidden="true">{Array.from({ length: 10 }, () => <i></i>)}</span>
          <b class="sd-mood-v" id="sd-mood">UNIMPRESSED</b>
        </div>
        <div class="stderr-term">
          <div class="sd-cmd" aria-hidden="true"><span>$</span> tail -f /dev/stderr <em>&mdash; reacts to what you do here</em></div>
          <div class="stderr-log" id="stderr-log" aria-live="polite"><span class="ln">&gt; tailing the reader&hellip;</span></div>
        </div>
      </div>
    </div>

    <div class="sign-off">
      <span class="so-tag">SITUATIONS WANTED</span>
      <span class="so-txt">CS undergrad opens black boxes for sport. Seeks a team that cares <i>why</i> things fail.</span>
      <a class="so-cta to" href="/#projects">See the work <span aria-hidden="true">&rarr;</span></a>
    </div>

    <div class="colophon">
      <span>&copy; {year} THE DAILY CHEETHIRALA &middot; ALL BUGS RESERVED</span>
      <span>{site.email}</span>
    </div>
  </div>
</section>

<style>
  /* ============================================================ EDITION (.edition) */
  /* OPAQUE sheet that rises over the sticky hero (the hero engine watches #about). */
  .edition {
    --ink: #141414;
    --cream: #f7f5f1;
    --cream2: #efece4;
    --red: #ed1c24;
    --lime: #b4ff2e;
    --gray: #8a8378;
    --fd: var(--font-display);
    --fm: var(--font-mono);
    --fi: var(--font-serif);
    --fb: var(--font-body);
    --ease: cubic-bezier(0.2, 0.9, 0.2, 1);

    position: relative;
    z-index: 1;
    background-color: var(--cream); /* OPAQUE — must fully cover the hero */
    color: var(--ink);
    font-family: var(--fb);
    border: 5px solid var(--ink);
    box-shadow:
      0 -3px 0 rgba(10, 10, 10, 0.32),
      0 -8px 0 rgba(10, 10, 10, 0.16),
      0 -15px 0 rgba(10, 10, 10, 0.07),
      12px 12px 0 var(--ink);
    background-image: var(--press-grain),
      linear-gradient(rgba(20, 20, 20, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(20, 20, 20, 0.045) 1px, transparent 1px);
    background-size: 300px 300px, var(--grid-size) var(--grid-size), var(--grid-size) var(--grid-size);
    margin: 0 clamp(10px, 1.4vw, 20px) clamp(10px, 1.4vw, 20px);
  }
  .page {
    max-width: 1500px;
    margin: 0 auto;
    padding: 14px clamp(12px, 3vw, 36px) clamp(40px, 6vw, 70px);
  }

  /* ── folio + masthead ── */
  .folio {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    font: 600 10px var(--fm);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gray);
    padding-bottom: 10px;
  }
  .folio b { color: var(--ink); }
  .folio-c { color: var(--red); }
  .mast-rule { border: 0; border-top: 3px solid var(--ink); margin: 0; }
  .masthead-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(10px, 2vw, 22px);
    padding: clamp(10px, 1.6vw, 18px) 0;
    position: relative;
  }
  .mast-emblem { width: clamp(28px, 3.4vw, 46px); color: var(--red); flex: none; }
  .masthead-title {
    font-family: var(--fd);
    font-size: clamp(2.2rem, 6.4vw, 5.6rem);
    line-height: 0.86;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .mast-ear {
    position: absolute;
    right: 0;
    font: 700 9px/1.5 var(--fm);
    letter-spacing: 0.16em;
    color: var(--gray);
    text-align: right;
  }
  .ticker {
    display: flex;
    align-items: stretch;
    background: var(--ink);
    color: var(--cream);
    overflow: hidden;
  }
  .ticker-flag {
    flex: none;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 0 12px;
    background: var(--red);
    font: 700 10px var(--fm);
    letter-spacing: 0.16em;
  }
  .blip { width: 7px; height: 7px; background: var(--cream); animation: blip 1.1s steps(1) infinite; }
  @keyframes blip { 50% { opacity: 0.2; } }
  .ticker-viewport { overflow: hidden; flex: 1; }
  .ticker-track { display: flex; width: max-content; animation: ticker 48s linear infinite; }
  .tk {
    white-space: nowrap;
    padding: 8px 0;
    font: 600 10.5px var(--fm);
    letter-spacing: 0.1em;
  }
  .tk i { font-style: normal; color: var(--red); padding: 0 16px; }
  .tk b { color: var(--lime); font-weight: 700; }
  @keyframes ticker { to { transform: translateX(-50%); } }

  /* ── the lead ── */
  .lead {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: clamp(20px, 4vw, 60px);
    padding: clamp(26px, 4vw, 52px) 0 clamp(26px, 3.4vw, 44px);
    border-bottom: 3px solid var(--ink);
  }
  .kicker {
    font: 700 11px var(--fm);
    letter-spacing: 0.16em;
    color: var(--red);
  }
  .headline {
    font-family: var(--fd);
    font-weight: 800;
    font-size: clamp(3.4rem, 9.6vw, 9.4rem);
    line-height: 0.84;
    letter-spacing: -0.015em;
    text-transform: none;
    margin: 14px 0 18px;
  }
  /* "black boxes" is set as one: a black box with the words on its lid. Hover
     (or focus, or a tap) tips the lid open on its hinge, and the box shows
     what was inside, one thing at a time. The lid sizes the box. */
  .hl-line { display: block; }
  .box {
    position: relative;
    display: inline-grid;
    vertical-align: bottom;
    cursor: pointer;
    outline: none;
    perspective: 900px;
  }
  .box > .box-in, .box > .box-lid { grid-area: 1 / 1; }
  .box-lid {
    position: relative;
    z-index: 2;
    padding: 0.06em 0.14em 0.02em;
    background: var(--ink);
    color: var(--cream);
    box-shadow: 0.06em 0.06em 0 var(--red);
    transform-origin: 50% 0;
    transition: transform 0.6s var(--ease), box-shadow 0.6s var(--ease), background 0.6s var(--ease);
  }
  .box-in {
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--cream2);
    border: 0.05em solid var(--ink);
    box-shadow: inset 0 0.08em 0 rgba(20, 20, 20, 0.12);
  }
  .box-in span {
    font-family: var(--fi);
    font-style: italic;
    font-weight: 500;
    font-size: 0.56em;
    letter-spacing: -0.02em;
    color: var(--red);
    white-space: nowrap;
    opacity: 0;
    transform: translateY(0.4em);
    transition: opacity 0.25s ease 0.12s, transform 0.4s var(--ease) 0.12s;
  }
  .box-tag {
    position: absolute;
    z-index: 3;
    right: -0.2em;
    top: -0.55em;
    font: 700 11px var(--fm);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    background: var(--lime);
    color: var(--ink);
    padding: 4px 7px;
    transform: rotate(4deg);
    transition: opacity 0.2s ease;
  }
  .box:hover .box-lid,
  .box:focus-visible .box-lid,
  .box.is-open .box-lid { transform: rotateX(76deg); box-shadow: 0 0.02em 0 var(--red); background: #2a2a2a; }
  .box:hover .box-in span,
  .box:focus-visible .box-in span,
  .box.is-open .box-in span { opacity: 1; transform: none; }
  .box:hover .box-tag,
  .box:focus-visible .box-tag,
  .box.is-open .box-tag { opacity: 0; }
  .box:focus-visible { outline: 3px solid var(--red); outline-offset: 6px; }
  .deck {
    font-family: var(--fi);
    font-style: italic;
    font-size: clamp(1.15rem, 2vw, 1.65rem);
    line-height: 1.25;
    max-width: 30ch;
  }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 10px;
    border: 2px solid var(--ink);
    font: 700 10px var(--fm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--cream);
  }
  .chip--live { background: var(--ink); color: var(--cream); }
  .chip--live i { width: 7px; height: 7px; border-radius: 50%; background: var(--lime); box-shadow: 0 0 0 3px rgba(180, 255, 46, 0.25); }

  /* fig. 1: the black box in pixel art, between the headline and the numbers. Its
     lid flips open on a loop and lets out what was inside; hovering the headline's
     box or the figure holds it open */
  .lead-art {
    display: none;
    align-self: center;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }
  .lead-art canvas { width: 100%; max-width: 330px; aspect-ratio: 1; display: block; }
  .lead-art canvas { image-rendering: pixelated; }
  .lead-art figcaption { font: 400 10px var(--font-pixel); letter-spacing: 0.08em; color: var(--gray); }
  @media (min-width: 1240px) {
    .lead { grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.8fr) minmax(0, 1fr); }
    .lead-art { display: flex; }
    .headline { font-size: clamp(3.4rem, 6.4vw, 8.2rem); }
  }
  .hl-line { white-space: nowrap; }
  .lead-side {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-self: end;
    gap: 0;
    border: 3px solid var(--ink);
    box-shadow: 8px 8px 0 var(--ink);
    background: var(--cream);
  }
  .num {
    padding: clamp(12px, 1.6vw, 20px);
    border-right: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .num:nth-child(2n) { border-right: 0; }
  .num:nth-child(n + 3) { border-bottom: 0; }
  .num b { font-family: var(--fd); font-size: clamp(2.4rem, 4.6vw, 4rem); line-height: 0.9; color: var(--red); }
  .num span { font: 600 10px/1.45 var(--fm); letter-spacing: 0.06em; text-transform: uppercase; color: #5e5a52; }
  .num:hover { background: var(--ink); }
  .num:hover b { color: var(--lime); }
  .num:hover span { color: var(--cream); }

  /* ── section heads ── */
  .sec-h {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    font: 800 11px var(--fm);
    letter-spacing: 0.2em;
    padding: 22px 0 14px;
  }
  .sec-s { font-weight: 500; letter-spacing: 0.1em; color: var(--gray); text-transform: uppercase; }

  /* ── the habit ── */
  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    border: 3px solid var(--ink);
  }
  .step {
    position: relative;
    padding: 16px clamp(12px, 1.4vw, 20px) 18px;
    border-right: 2px solid var(--ink);
    background: var(--cream);
    cursor: default;
    outline: none;
    transition: background 0.3s var(--ease), color 0.3s var(--ease);
    display: flex;
    flex-direction: column;
  }
  .step:last-child { border-right: 0; }
  .step-top { display: flex; justify-content: space-between; font: 700 11px var(--fm); letter-spacing: 0.14em; color: var(--gray); }
  .step-arrow { font-size: 16px; line-height: 1; }
  .step-viz {
    height: 92px;
    margin: 10px 0 12px;
    display: grid;
    place-items: center;
    border: 2px solid currentColor;
    border-color: rgba(20, 20, 20, 0.18);
    overflow: hidden;
    position: relative;
  }
  .step-viz svg { width: 100%; height: 100%; }
  .step-k {
    font-family: var(--fd);
    font-size: clamp(1.9rem, 3vw, 2.8rem);
    line-height: 0.9;
  }
  .step-line { font-size: 15px; line-height: 1.35; margin-top: 8px; font-weight: 500; }
