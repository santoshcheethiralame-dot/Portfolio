---
import {
  research,
  corrections,
  culpritCase,
  attributionJobs,
  localization,
  instrumentChecks,
  experience,
} from '../data/site';

/* ------------------------------------------------------------------
   Research — "The Research Desk". A broadsheet spread in the Daily
   Cheethirala. A corrections box runs across the top; the lead study
   carries a console over a real subset lattice, two studies run as
   columns with their own bench instruments, and the work in progress
   runs as an ink band with a live simulator.

   Content is data-driven from site.ts. A study with `results: false`
   renders only its headline, deck and body: no figures, no widget.

   Every node is rendered server-side so the scoped <style> applies.
   The scripts only toggle classes, set text and set inline styles, and
   they are event-driven: no rAF, no canvas, no timers.
   ------------------------------------------------------------------ */

const byId = Object.fromEntries(research.map((s) => [s.id, s]));
const culprit = byId.culprit;
const precise = byId.precise;
const instrument = byId.instrument;
const mm = byId.missingmass;
const also = experience.filter((e) => !e.foldedIntoResearch);

/* ---- the subset lattice for study 01 (sizes 0–3, then the full context) ---- */
const letters = culpritCase.passages.map((p) => p.id);
function combos(k: number, start = 0, acc = ''): string[] {
  if (acc.length === k) return [acc];
  const out: string[] = [];
  for (let i = start; i < letters.length; i++) out.push(...combos(k, i + 1, acc + letters[i]));
  return out;
}
const LW = 1000;
const rowY = [34, 104, 174, 244];
const levels = [0, 1, 2, 3].map((k) => combos(k));
const nodes = levels.flatMap((row, k) =>
  row.map((key, i) => ({
    key: key || '∅',
    id: key,
    x: Math.round(((i + 1) * LW) / (row.length + 1)),
    y: rowY[k],
    size: k,
  }))
);
const fullNode = { id: letters.join(''), key: letters.join(''), x: LW / 2, y: 330, size: 6 };
const pos = Object.fromEntries([...nodes, fullNode].map((n) => [n.id, n]));
const suff = new Set(culpritCase.sufficient);
const mins = new Set(culpritCase.minimal);
const edges = culpritCase.violations.map(([a, b]) => ({ a, b, A: pos[a], B: pos[b] }));

/* ---- localization heatmap for study 03 ---- */
const loc = localization;
const locCells = loc.layers.flatMap((layer, r) =>
  loc.strengths.map((strength, c) => ({
    layer,
    strength,
    real: loc.real[r][c],
    random: loc.random[r][c],
    primary: layer === loc.primary.layer && strength === loc.primary.strength,
  }))
);
const pct = (v: number) => Math.round(v * 100);

/* ---- fixed jitter for the eight restart "darts" in study 02 ---- */
const darts = [
  [0.0, 0.0], [0.9, 0.35], [-0.7, 0.6], [0.3, -0.95],
  [-0.85, -0.4], [0.55, 0.85], [-0.2, -0.65], [0.95, -0.3],
];

/* ---- the simulator grid for study 04 ---- */
const MM_N = 40;
const MM_K = 12;
---

<section class="section research" id="research">
  <div class="section-head rd-head">
    <span class="kicker">research</span>
    <h2 class="h2 rd-title" data-fade>The <em class="rd-em">Research</em> Desk</h2>
    <p class="rd-lede" data-fade>
      I test the tools we use to <b>explain and audit language models</b> against answers that are
      already known. Three papers under review and one study in progress. Each takes a check the field
      trusts and measures whether it <b>measures what it claims to</b>.
    </p>
  </div>

  <div class="rd-sheet">
    <div class="rd-folio">
      <span>VOL. PES1UG24CS127 · <b>THE RESEARCH DESK</b></span>
      <span class="rd-folio-c">{research.length} STUDIES · 3 UNDER REVIEW</span>
      <span>BENGALURU · 2026</span>
    </div>

    <!-- ================= CORRECTIONS ================= -->
    <aside class="rd-corr" aria-label="Corrections and clarifications">
      <div class="rd-corr-h">
        <span class="rd-corr-t">Corrections <i>&amp;</i> Clarifications</span>
        <span class="rd-corr-s">What the field’s checks reported, and what measurement found</span>
      </div>
      <ol class="rd-corr-list">
        {corrections.map((c, i) => (
          <li class={c.pending ? 'is-pending' : ''}>
            <span class="rd-corr-n">{String(i + 1).padStart(2, '0')} · {c.desk}</span>
            <p>{c.text}</p>
          </li>
        ))}
      </ol>
    </aside>

    <!-- ================= STUDY 01 — LEAD ================= -->
    {culprit && (
      <article class="rd-lead" id="study-culprit">
        <div class="rd-kicker">▶ STUDY No.{culprit.no} · {culprit.kicker}</div>
        <h3 class="rd-headline">{culprit.headline}</h3>
        <p class="rd-deck">{culprit.deck}</p>
        <div class="rd-byline">
          <span class="rd-stamp">{culprit.name}</span>
          <span>{culprit.byline}</span>
          <span class="rd-stamp rd-stamp--dev">{culprit.status}</span>
        </div>
        <p class="rd-paper">PAPER · <i>{culprit.title}</i></p>

        {culprit.results && (
          <section class="rd-console" data-culprit aria-label="Subset lattice console">
            <div class="rd-c-head">
              <span>▶ THE LINEUP · <span class="lime">EVERY SUBSET, QUERIED</span></span>
              <span class="rd-c-q">
                IN CONTEXT: <span class="lime" data-incount>0</span>/6 · MINIMAL SETS FOUND:
                <span class="lime" data-found>0</span>/{culpritCase.minimal.length}
              </span>
            </div>

            <div class="rd-c-task">
              <p class="rd-c-question">
                <b>Q:</b> {culpritCase.question}<br />
                <span class="dim">
                  GOLD: <b class="ok">{culpritCase.gold}</b> · FULL-CONTEXT ANSWER:
                  <b class="bad">{culpritCase.wrong}</b> · {culpritCase.dataset} · {culpritCase.model}
                </span>
              </p>
              <div class="rd-c-ans is-none" data-ansbox>
                <span class="lab">MODEL ANSWER, FROM THIS CONTEXT</span>
                <span class="val" data-ansval>—</span>
                <span class="tag" data-anstag>NO CONTEXT</span>
              </div>
            </div>

            <div class="rd-stage">
              <div class="rd-lineup" data-lineup>
                {culpritCase.passages.map((p) => (
                  <button
                    class={`rd-chunk${p.gold ? ' is-gold' : ''}`}
                    type="button"
                    data-chunk={p.id}
                    aria-pressed="false"
                    aria-label={`Passage ${p.id}: ${p.label}. Add to context`}
                  >
                    <span class="rd-cid">PASSAGE {p.id}{p.gold && <b class="rd-goldtag">GOLD</b>}</span>
                    <span class="rd-ctext">{p.label}</span>
                    <span class="rd-cact" aria-hidden="true"><span class="add">+ ADD</span><span class="rm">− REMOVE</span></span>
                  </button>
                ))}
              </div>
              <p class="rd-stage-cap">
                BUILD A CONTEXT · FIND THE SMALLEST SETS THAT MAKE THE MODEL REPEAT “{culpritCase.wrong.toUpperCase()}”
              </p>
            </div>

            <div class="rd-lattice-wrap">
              <svg class="rd-lattice" viewBox={`0 0 ${LW} 362`} role="img" aria-label="Subset lattice: every queried subset of the six passages">
                {rowY.map((y, k) => (
                  <text class="rd-lt-row" x="6" y={y + 4}>SIZE {k}</text>
                ))}
                <text class="rd-lt-row" x="6" y={fullNode.y + 4}>SIZE 6</text>
                <line class="rd-lt-gap" x1="70" y1="288" x2={LW - 10} y2="288" />
                <text class="rd-lt-gapt" x={LW / 2} y="284" text-anchor="middle">SIZES 4–5 NOT QUERIED IN THIS RUN</text>
                {edges.map((e) => (
                  <line class="rd-lt-edge" data-edge={`${e.a}-${e.b}`} x1={e.A.x} y1={e.A.y} x2={e.B.x} y2={e.B.y} />
                ))}
                {[...nodes, fullNode].map((n) => (
                  <g
                    class={`rd-lt-node${suff.has(n.id) ? ' is-suff' : ''}${mins.has(n.id) ? ' is-minset' : ''}${n.size === 6 ? ' is-full' : ''}`}
                    data-node={n.id}
                  >
                    <circle cx={n.x} cy={n.y} r={n.size === 6 ? 24 : n.size === 3 ? 17 : 19} />
                    <text x={n.x} y={n.y + 3.5} text-anchor="middle">{n.key}</text>
                  </g>
                ))}
              </svg>
              <div class="rd-lt-key" aria-hidden="true">
                <span><i class="k-suff"></i>REPEATS THE ERROR</span>
                <span><i class="k-no"></i>DOES NOT</span>
                <span><i class="k-min"></i>MINIMAL SUFFICIENT SET</span>
                <span><i class="k-edge"></i>VIOLATION: ADDING A PASSAGE BREAKS IT</span>
                <span><i class="k-cur"></i>YOUR CONTEXT</span>
              </div>
            </div>

            <div class="rd-verdict">
              <p class="rd-v-txt" data-verdict aria-live="polite"></p>
              <div class="rd-v-btns">
                <button class="rd-btn" type="button" data-full>Full context</button>
                <button class="rd-btn" type="button" data-reveal>Fill the lattice</button>
                <button class="rd-btn rd-btn--pri" type="button" data-reset>Reset</button>
              </div>
            </div>

            <p class="rd-honest">
              <b>Real data.</b> This is Figure 1 of the paper: one HotpotQA error by {culpritCase.model}, first
              run, subsets up to three passages plus the full context. Passage texts are summarised, and
              answers are shown only where the paper states them.
            </p>
          </section>
        )}

        <div class="rd-body">
          <div class="rd-flow">
            {culprit.body.map((p, i) => <p class={i === 0 ? 'has-dropcap' : ''} set:html={p} />)}
          </div>
          <aside class="rd-side">
            {culprit.results && culprit.figures && (
              <div class="rd-box">
                <div class="rd-box-head">// THE FINDING</div>
                {culprit.figures.map((f) => (
                  <div class="rd-stat">
                    <div class="rd-stat-v">{f.v}{f.note && <span class="ci">{f.note}</span>}</div>
                    <div class="rd-stat-l" set:html={f.l} />
                  </div>
                ))}
                {culprit.source && <div class="rd-srcline">{culprit.source}</div>}
              </div>
            )}
          </aside>
        </div>

        {culprit.results && (
          <div class="rd-jobs">
            <div class="rd-jobs-h">
              <span class="rd-jobs-t">Three jobs, three verdicts</span>
              <span class="rd-jobs-s">Scoring a method on its top pick only tests the first job</span>
            </div>
            <div class="rd-jobs-row">
              {attributionJobs.map((j, i) => (
                <div class="rd-job">
                  <div class="rd-job-top">
                    <span class="rd-job-n">JOB {i + 1}</span>
                    <span class={`rd-verd rd-verd--${j.verdict.toLowerCase()}`}>{j.verdict}</span>
                  </div>
                  <div class="rd-job-name">{j.job}</div>
                  {[j.a, j.b].map((x, xi) => (
                    <div class={`rd-jbar${xi === 1 ? ' is-base' : ''}`}>
                      <div class="rd-jbar-t"><b>{x.v}%</b> {x.l}</div>
                      <div class="rd-jbar-b"><i style={`width:${x.v}%`}></i></div>
                    </div>
                  ))}
                </div>
              ))}
            </div>
          </div>
        )}
      </article>
    )}

    <!-- ================= STUDIES 02 + 03 ================= -->
    <div class="rd-row2">
      {precise && (
        <article class="rd-sub" id="study-precise">
          <div class="rd-kicker">▶ STUDY No.{precise.no} · {precise.kicker}</div>
          <h3 class="rd-sub-head">{precise.headline}</h3>
          <p class="rd-sub-deck">{precise.deck}</p>
          <div class="rd-byline rd-byline--tight">
            <span class="rd-stamp">{precise.name}</span>
            <span class="rd-stamp rd-stamp--dev">{precise.status}</span>
          </div>
          <p class="rd-paper">PAPER · <i>{precise.title}</i></p>

          {precise.results && (
            <section class="rd-bench" data-precise aria-label="Precision versus trueness bench">
              <div class="rd-c-head">
                <span>▶ THE BENCH · <span class="lime">SHRINK ONE NORM GAIN</span></span>
                <span class="rd-c-q" data-pt-mode>STANDARDISED</span>
              </div>
              <div class="rd-pt">
                <svg class="rd-board" viewBox="-110 -110 220 220" role="img" aria-label="Target: eight restarts of the fit against the true weights">
                  {[100, 75, 50, 25].map((r) => <circle class="ring" r={r} />)}
                  <circle class="bull" r="9" />
                  <line class="cross" x1="-104" y1="0" x2="104" y2="0" />
                  <line class="cross" x1="0" y1="-104" x2="0" y2="104" />
                  <text class="bull-t" x="0" y="24" text-anchor="middle">TRUE WEIGHTS</text>
                  {darts.map(([dx, dy]) => (
                    <circle class="dart" r="5.5" data-dart data-dx={dx} data-dy={dy} cx="0" cy="0" />
                  ))}
                </svg>
                <dl class="rd-checks">
                  <div class="rd-check">
                    <dt>Test accuracy</dt>
                    <dd><span data-pt-acc>0.998</span><b class="pass" data-pt-acc-v>PASS</b></dd>
                  </div>
                  <div class="rd-check">
                    <dt>Restart agreement</dt>
                    <dd><span data-pt-agr>0.995</span><b class="pass" data-pt-agr-v>PASS</b></dd>
                  </div>
                  <div class="rd-check rd-check--bar">
                    <dt>Share on one near-constant coordinate</dt>
                    <dd><span data-pt-share>0.0%</span><span class="rd-sharebar"><i data-pt-sharebar></i></span></dd>
                  </div>
                  <div class="rd-check rd-check--truth">
                    <dt>Alignment with the true weights</dt>
                    <dd><span data-pt-aln>0.995</span><b class="pass" data-pt-aln-v>TRUE</b></dd>
                  </div>
                </dl>
              </div>
              <div class="rd-pt-ctl">
                <label class="rd-pt-l" for="rd-gain">
                  GAIN MULTIPLIER <b data-pt-c>c = 1</b>
                </label>
                <input id="rd-gain" class="rd-range" type="range" min="0" max="50" step="1" value="0" data-pt-range aria-describedby="rd-gain-cap" />
                <div class="rd-pt-ticks" aria-hidden="true"><span>1</span><span>10⁻¹</span><span>10⁻²</span><span>10⁻³</span><span>10⁻⁴</span><span>10⁻⁵</span></div>
                <button class="rd-btn rd-btn--ink" type="button" data-pt-std aria-pressed="true">Standardise coordinates: ON</button>
              </div>
              <p class="rd-verdict-s" data-pt-verdict aria-live="polite"></p>
              <p class="rd-honest" id="rd-gain-cap">
                <b>Illustrative.</b> The share follows the paper’s Proposition 1 (odds grow as 1/c²), pinned to its
                gain intervention: half the direction is on the coordinate at c = 10⁻², at least 0.999 at
                10⁻⁵, and below 0.006 at every dose without standardisation. A fit fails when alignment is
                below 0.95.
              </p>
            </section>
          )}

          {precise.body.map((p) => <p class="rd-sub-p" set:html={p} />)}

          {precise.results && precise.figures && (
            <div class="rd-minis">
              {precise.figures.map((f) => (
                <div class="rd-mini">
                  <div class="rd-mini-v">{f.v}</div>
                  <div class="rd-mini-l" set:html={f.l} />
                </div>
              ))}
            </div>
          )}
          {precise.source && <div class="rd-srcline rd-srcline--flat">{precise.source}</div>}
        </article>
      )}

      {instrument && (
        <article class="rd-sub" id="study-instrument">
          <div class="rd-kicker">▶ STUDY No.{instrument.no} · {instrument.kicker}</div>
          <h3 class="rd-sub-head">{instrument.headline}</h3>
          <p class="rd-sub-deck">{instrument.deck}</p>
          <div class="rd-byline rd-byline--tight">
            <span class="rd-stamp">{instrument.name}</span>
            <span class="rd-stamp rd-stamp--dev">{instrument.status}</span>
          </div>
          <p class="rd-paper">PAPER · <i>{instrument.title}</i></p>

          {instrument.results && (
            <section class="rd-bench" data-instrument aria-label="Concept-injection instrument audit">
              <div class="rd-c-head">
                <span>▶ THE AUDIT · <span class="lime">THREE ASSUMPTIONS</span></span>
                <span class="rd-c-q">NO REGIME HELD ALL THREE</span>
              </div>
              <div class="rd-gauges">
                {instrumentChecks.map((c) => (
                  <div class="rd-gauge">
                    <div class="rd-gauge-top">
                      <span class="rd-gauge-k">{c.k}</span>
                      <span class="rd-gauge-x">✗ BREAKS</span>
                    </div>
                    <div class="rd-gauge-q">{c.q}</div>
                    <div class="rd-gauge-v">{c.v}</div>
                    <div class="rd-gauge-f">{c.fail}</div>
                  </div>
                ))}
              </div>

              <div class="rd-heat-wrap">
                <div class="rd-heat-h">
                  <span>WHICH SENTENCE WAS INJECTED? · LLAMA-3.1-8B · 10 OPTIONS, CHANCE 10%</span>
                  <div class="rd-seg" role="group" aria-label="Show accuracy for">
                    <button type="button" class="is-on" data-heat-mode="real" aria-pressed="true">Concept vector</button>
                    <button type="button" data-heat-mode="random" aria-pressed="false">Random, same norm</button>
                    <button type="button" data-heat-mode="gap" aria-pressed="false">Difference</button>
                  </div>
                </div>
                <div class="rd-heat" style={`--cols:${loc.strengths.length}`}>
                  <span class="rd-heat-corner">LAYER ↓ · STRENGTH →</span>
                  {loc.strengths.map((s) => <span class="rd-heat-col">α {s}</span>)}
                  {loc.layers.map((layer) => (
                    <>
                      <span class="rd-heat-row">L{layer}</span>
                      {locCells
                        .filter((c) => c.layer === layer)
                        .map((c) => (
                          <span
                            class={`rd-cell${c.primary ? ' is-primary' : ''}`}
                            data-cell
                            data-real={c.real}
                            data-random={c.random}
                            style={`--v:${c.real}`}
                          >
                            <b data-cell-v>{pct(c.real)}%</b>
                            {c.primary && <em>FILED</em>}
                          </span>
                        ))}
                    </>
                  ))}
                </div>
                <p class="rd-verdict-s rd-verdict-s--light" data-heat-verdict aria-live="polite">
                  The concept vector looks like it works: <b>97%</b> in the filed cell. Now switch to random vectors.
                </p>
              </div>
              <p class="rd-honest">
                <b>Real data.</b> Table 2 of the paper: 600 trials per cell and arm. “Random” is a direction of the
                same norm carrying no concept.
              </p>
            </section>
          )}

          {instrument.body.map((p) => <p class="rd-sub-p" set:html={p} />)}
          {instrument.source && <div class="rd-srcline rd-srcline--flat">{instrument.source}</div>}
        </article>
      )}
    </div>

    <!-- ================= STUDY 04 — WORK IN PROGRESS ================= -->
    {mm && (
      <article class="rd-band" id="study-missingmass">
        <div class="rd-band-text">
          <div class="rd-kicker rd-kicker--lime">▶ STUDY No.{mm.no} · {mm.kicker}</div>
          <h3 class="rd-band-head">{mm.headline}</h3>
          <p class="rd-band-deck">{mm.deck}</p>
          <div class="rd-byline rd-byline--tight rd-byline--ink">
            <span class="rd-stamp rd-stamp--lime">{mm.name}</span>
            <span>{mm.byline}</span>
            <span class="rd-stamp rd-stamp--cream">{mm.status}</span>
            {mm.links?.github && (
              <a class="rd-src rd-src--lime" href={mm.links.github} target="_blank" rel="noopener">SOURCE ↗</a>
            )}
          </div>
          {mm.body.map((p) => <p class="rd-band-p" set:html={p} />)}
          {mm.results && mm.figures && (
            <div class="rd-minis rd-minis--ink">
              {mm.figures.map((f) => (
                <div class="rd-mini">
                  <div class="rd-mini-v">{f.v}</div>
                  <div class="rd-mini-l" set:html={f.l} />
                </div>
              ))}
            </div>
          )}
          {mm.source && <div class="rd-srcline rd-srcline--ink">{mm.source}</div>}
        </div>

        {mm.results && (
          <section class="rd-sim" data-mm aria-label="Capture–recapture simulator">
            <div class="rd-c-head rd-c-head--lime">
              <span>▶ THE SIMULATOR · <span class="ink">{MM_N} PLANTED FAILURE MODES</span></span>
              <span class="rd-c-q">SOME ARE MUCH HARDER TO FIND</span>
            </div>
            <div class="rd-sim-body">
              <div class="rd-sim-grid" style={`--n:${MM_N}`} aria-hidden="true">
                <span class="rd-sim-lab">FOUND BY</span>
                {Array.from({ length: MM_N }, (_, i) => <span class="rd-sim-freq" data-mm-freq={i}></span>)}
                {Array.from({ length: MM_K }, (_, r) => (
                  <>
                    <span class="rd-sim-lab" data-mm-runlab={r}>RUN {r + 1}</span>
                    {Array.from({ length: MM_N }, (_, i) => <span class="rd-sim-c" data-mm-c={`${r}-${i}`}></span>)}
                  </>
                ))}
                <span class="rd-sim-lab">FINDABILITY</span>
                {Array.from({ length: MM_N }, (_, i) => <span class="rd-sim-p" data-mm-p={i}><i></i></span>)}
              </div>

              <div class="rd-sim-read">
                <div class="rd-sim-stat">
                  <span class="k">RUNS</span><span class="v" data-mm-k>0</span>
                </div>
                <div class="rd-sim-stat">
                  <span class="k">FAILURE MODES FOUND</span><span class="v" data-mm-s>0</span>
                </div>
                <div class="rd-sim-stat">
                  <span class="k">FOUND BY ONE RUN ONLY</span><span class="v" data-mm-q1>0</span>
                </div>
                <div class="rd-sim-meter">
                  <div class="k">COVERAGE · ESTIMATED <b data-mm-chat>—</b> · TRUE <b data-mm-ctrue>—</b></div>
                  <div class="rd-meter"><i class="est" data-mm-cbar></i><i class="tru" data-mm-tbar></i></div>
                </div>
                <div class="rd-sim-meter">
                  <div class="k">HOW MANY EXIST · LOWER BOUND <b data-mm-chao>—</b> · TRUE <b data-mm-ntrue>{MM_N}</b></div>
                  <div class="rd-meter"><i class="est" data-mm-nbar></i><i class="tru" style="left:100%"></i></div>
                </div>
                <div class="rd-sim-meter">
                  <div class="k">NEW FINDS FROM <span data-mm-m>K</span> MORE RUNS · PREDICTED <b data-mm-dhat>—</b> · EXPECTED <b data-mm-dtrue>—</b></div>
                </div>
              </div>
            </div>
            <div class="rd-verdict rd-verdict--lime">
              <p class="rd-v-txt" data-mm-verdict aria-live="polite">Run the audit. Each run finds each failure mode with its own probability.</p>
              <div class="rd-v-btns">
