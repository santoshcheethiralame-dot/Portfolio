  .cl-file-v i.is-b { background: var(--bink); color: var(--blime); }
  .cl-file-q { font-family: var(--fd); font-size: 2.2rem; line-height: 0.9; color: rgba(20, 20, 20, 0.2); }
  .cl-file.is-found { border: 2px solid var(--bink); background: var(--bred); }
