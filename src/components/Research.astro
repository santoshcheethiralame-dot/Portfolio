---
import {
  research,
  corrections,
  culpritCase,
  attributionJobs,
  localization,
  instrumentChecks,
  experience,
} from '../data/site';

/* ------------------------------------------------------------------
   Research — "The Research Desk". A broadsheet spread in the Daily
   Cheethirala. A corrections box runs across the top; the lead study
   carries a console over a real subset lattice, two studies run as
   columns with their own bench instruments, and the work in progress
   runs as an ink band with a live simulator.

   Content is data-driven from site.ts. A study with `results: false`
   renders only its headline, deck and body: no figures, no widget.

   Every node is rendered server-side so the scoped <style> applies.
   The scripts only toggle classes, set text and set inline styles, and
   they are event-driven: no rAF, no canvas, no timers.
   ------------------------------------------------------------------ */

const byId = Object.fromEntries(research.map((s) => [s.id, s]));
const culprit = byId.culprit;
const precise = byId.precise;
const instrument = byId.instrument;
const mm = byId.missingmass;
const also = experience.filter((e) => !e.foldedIntoResearch);

/* ---- localization heatmap for study 03 ---- */
const loc = localization;
const locCells = loc.layers.flatMap((layer, r) =>
  loc.strengths.map((strength, c) => ({
    layer,
    strength,
    real: loc.real[r][c],
    random: loc.random[r][c],
    primary: layer === loc.primary.layer && strength === loc.primary.strength,
  }))
);
const pct = (v: number) => Math.round(v * 100);

/* ---- fixed jitter for the eight restart "darts" in study 02 ---- */
const darts = [
  [0.0, 0.0], [0.9, 0.35], [-0.7, 0.6], [0.3, -0.95],
  [-0.85, -0.4], [0.55, 0.85], [-0.2, -0.65], [0.95, -0.3],
];

/* ---- the simulator grid for study 04 ---- */
const MM_N = 40;
const MM_K = 12;
---

<section class="section research" id="research">
  <div class="section-head rd-head">
    <span class="kicker">research</span>
    <h2 class="h2 rd-title" data-fade>The <em class="rd-em">Research</em> Desk</h2>
    <p class="rd-lede" data-fade>
      I test the tools that <b>explain and audit language models</b>, against answers that are already known.
    </p>
    <!-- the manuscripts on the desk, fanned; each opens its study -->
    <div class="rd-papers" aria-label="The four studies">
      {research.map((st, i) => (
        <a class="rd-ms" href={`#study-${st.id}`} style={`--i:${i}`}>
          <span class="rd-ms-top"><span>MS No.{st.no}</span><span>{st.byline.indexOf('&') > 0 ? '2 AUTHORS' : 'SOLE AUTHOR'}</span></span>
          <span class="rd-ms-t">{st.title}</span>
          <span class="rd-ms-lines" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span class={`rd-ms-stamp${st.status.indexOf('REVIEW') >= 0 ? '' : ' is-pre'}`}>{st.status}</span>
        </a>
      ))}
    </div>
  </div>

  <div class="rd-sheet">
    <div class="rd-folio">
      <span>VOL. PES1UG24CS127 · <b>THE RESEARCH DESK</b></span>
      <span class="rd-folio-c">{research.length} STUDIES · 3 UNDER REVIEW</span>
      <span>BENGALURU · 2026</span>
    </div>

    <!-- ================= THE DESK: four studies, read down the page ================= -->
    <nav class="rd-rail" aria-label="Studies on this desk">
      {research.map((st, i) => (
        <a class={`rd-rail-i${i === 0 ? ' is-on' : ''}`} href={`#study-${st.id}`} data-rail={st.id}>
          <span class="rd-rail-no">No.{st.no}</span>
          <span class="rd-rail-name">{st.name}</span>
          <i class="rd-rail-fill" aria-hidden="true"></i>
        </a>
      ))}
    </nav>

    <div class="rd-panels">
      {research.map((st, i) => {
        const c = corrections[i];
        const cut = c ? c.text.indexOf('. ') : -1;
        const claim = c ? (cut > 0 ? c.text.slice(0, cut + 1) : c.text) : '';
        const found = c && cut > 0 ? c.text.slice(cut + 2) : '';
        return (
          <article class="rd-panel" id={`study-${st.id}`} data-study={st.id}>
            <div class="rd-p-top">
              <div class="rd-p-q">
                <div class="rd-kicker">▶ STUDY No.{st.no} · {st.kicker}</div>
                <h3 class="rd-headline">{st.headline}</h3>
                <p class="rd-deck">{st.deck}</p>
              </div>
              {c && (
                <div class={`rd-vs${c.pending ? ' is-pending' : ''}`}>
                  <div class="rd-vs-row rd-vs-claim"><span class="rd-vs-k">THE FIELD ASSUMED</span><p>{claim}</p></div>
                  <div class="rd-vs-row rd-vs-found"><span class="rd-vs-k">{c.pending ? 'IN PROGRESS' : 'MEASURED'}</span><p>{found}</p></div>
                </div>
              )}
            </div>

            {st.results && st.figures && (
              <div class="rd-figs">
                {st.figures.map((f) => (
                  <div class="rd-fig">
                    <div class="rd-fig-v">{f.v}{f.note && <span class="ci">{f.note}</span>}</div>
                    <div class="rd-fig-l" set:html={f.l} />
                  </div>
                ))}
              </div>
            )}

            {st.id === 'culprit' && culprit.results && (
              <section class="cl" data-culprit aria-label="Find the culprit: which passages make the model repeat its error">
                <div class="cl-case">
                  <div class="cl-q"><span class="cl-k">THE QUESTION · {culpritCase.dataset}</span><p>{culpritCase.question}</p></div>
                  <div class="cl-truth"><span class="cl-k">RIGHT ANSWER</span><b>{culpritCase.gold}</b></div>
                  <div class="cl-crime"><span class="cl-k">{culpritCase.model} SAID, FROM ALL SIX</span><b>{culpritCase.wrong}</b></div>
                </div>

                <div class="cl-main">
                  <div class="cl-left">
                    <div class="cl-step"><b>1</b> Hand the model some passages. Which ones make it say “{culpritCase.wrong}”?</div>
                    <div class="cl-suspects">
                      {culpritCase.passages.map((p) => (
                        <button class={`cl-sus${p.gold ? ' is-gold' : ''}`} type="button" data-chunk={p.id} aria-pressed="false" aria-label={`Passage ${p.id}: ${p.label}`}>
                          <span class="cl-sus-l">{p.id}</span>
                          <span class="cl-sus-t">{p.label}</span>
                          {p.gold && <span class="cl-sus-g">GOLD</span>}
                        </button>
                      ))}
                    </div>
                    <div class="cl-out is-none" data-ansbox>
                      <span class="cl-k">THE MODEL ANSWERS <span class="cl-ctx">FROM <b data-incount>0</b> PASSAGES</span></span>
                      <b class="cl-out-v" data-ansval>—</b>
                      <span class="cl-out-tag" data-anstag>SHOW IT SOME PASSAGES</span>
                    </div>
                    <p class="cl-say" data-verdict aria-live="polite"></p>
                  </div>

                  <div class="cl-right">
                    <div class="cl-step"><b>2</b> Every single passage and every pair. Tap one to test it.</div>
                    <div class="cl-grid" role="grid" aria-label="Singles on the diagonal, pairs above it">
                      <span class="cl-gh"></span>
                      {culpritCase.passages.map((p) => <span class="cl-gh">{p.id}</span>)}
                      {culpritCase.passages.map((r, ri) => (
                        <>
                          <span class="cl-gh">{r.id}</span>
                          {culpritCase.passages.map((c, ci) =>
                            ci < ri ? (
                              <span class="cl-cell is-void" aria-hidden="true"></span>
                            ) : (
                              <button
                                class={`cl-cell${ci === ri ? ' is-single' : ''}`}
                                type="button"
                                data-node={ci === ri ? r.id : r.id + c.id}
                                aria-label={ci === ri ? `Passage ${r.id} alone` : `Passages ${r.id} and ${c.id}`}
                              >
                                <span>{ci === ri ? r.id : r.id + c.id}</span>
                              </button>
                            )
                          )}
                        </>
                      ))}
                    </div>
                    <div class="cl-key" aria-hidden="true">
                      <span><i class="k-err"></i>repeats the error</span>
                      <span><i class="k-no"></i>doesn’t</span>
                      <span><i class="k-q"></i>not tested yet</span>
                    </div>
                  </div>
                </div>

                <div class="cl-files">
                  <div class="cl-files-h"><span>CASE FILES · <b data-found>0</b>/{culpritCase.minimal.length} CULPRIT SETS FOUND</span><span class="cl-files-s">the smallest sets that repeat the error</span></div>
                  <div class="cl-files-row">
                    {culpritCase.minimal.map((m, i) => (
                      <div class="cl-file" data-file={m}>
                        <span class="cl-file-n">SET {i + 1}</span>
                        <span class="cl-file-v">{m.split('').map((ch) => <i class={ch === 'B' ? 'is-b' : ''}>{ch}</i>)}</span>
                        <span class="cl-file-q">? + ?</span>
                      </div>
                    ))}
                    <div class="cl-file cl-file--twist" data-twists>
                      <span class="cl-file-n">PLOT TWISTS</span>
                      <ul>
                        {culpritCase.violations.map(([base, sup]) => {
                          const add = sup.split('').filter((ch) => !base.includes(ch))[0];
                          const ans = culpritCase.answers[sup];
                          return (
                            <li data-twist={sup}>
                              <b>{base.split('').join('+')}</b> + {add} → {ans ? (ans === culpritCase.gold ? <em class="ok">{ans} ✓</em> : <em>{ans}</em>) : <em>stops</em>}
                            </li>
                          );
                        })}
                      </ul>
                    </div>
                  </div>
                </div>

                <div class="rd-verdict cl-ctl">
                  <p class="rd-v-txt">Three sets, all built on <b>B</b>, none of them B alone. Adding a passage can also undo the error.</p>
                  <div class="rd-v-btns">
                    <button class="rd-btn" type="button" data-full>All six</button>
                    <button class="rd-btn" type="button" data-reveal>Show me</button>
                    <button class="rd-btn rd-btn--pri" type="button" data-reset>Reset</button>
                  </div>
                </div>

                <p class="rd-honest">
                  <b>Real data.</b> Figure 1 of the paper: one HotpotQA error by {culpritCase.model}, every subset up to three
                  passages plus the full context. Passage texts are summarised; answers appear only where the paper states them.
                </p>
              </section>
            )}
            {st.id === 'culprit' && culprit.results && (
              <div class="rd-jobs">
                <div class="rd-jobs-h">
                  <span class="rd-jobs-t">Three jobs, three verdicts</span>
                  <span class="rd-jobs-s">Scoring a method on its top pick only tests the first job</span>
                </div>
                <div class="rd-jobs-row">
                  {attributionJobs.map((j, i) => (
                    <div class="rd-job">
                      <div class="rd-job-top">
                        <span class="rd-job-n">JOB {i + 1}</span>
                        <span class={`rd-verd rd-verd--${j.verdict.toLowerCase()}`}>{j.verdict}</span>
                      </div>
                      <div class="rd-job-name">{j.job}</div>
                      {[j.a, j.b].map((x, xi) => (
                        <div class={`rd-jbar${xi === 1 ? ' is-base' : ''}`}>
                          <div class="rd-jbar-t"><b>{x.v}%</b> {x.l}</div>
                          <div class="rd-jbar-b"><i style={`width:${x.v}%`}></i></div>
                        </div>
                      ))}
                    </div>
                  ))}
                </div>
              </div>
            )}
            {st.id === 'precise' && precise.results && (
              <section class="rd-bench" data-precise aria-label="Precision versus trueness bench">
                <div class="rd-c-head">
                  <span>▶ THE BENCH · <span class="lime">SHRINK ONE NORM GAIN</span></span>
                  <span class="rd-c-q" data-pt-mode>STANDARDISED</span>
                </div>
                <div class="rd-pt">
                  <svg class="rd-board" viewBox="-110 -110 220 220" role="img" aria-label="Target: eight restarts of the fit against the true weights">
                    {[100, 75, 50, 25].map((r) => <circle class="ring" r={r} />)}
                    <circle class="bull" r="9" />
                    <line class="cross" x1="-104" y1="0" x2="104" y2="0" />
                    <line class="cross" x1="0" y1="-104" x2="0" y2="104" />
                    <text class="bull-t" x="0" y="24" text-anchor="middle">TRUE WEIGHTS</text>
                    {darts.map(([dx, dy]) => (
                      <circle class="dart" r="5.5" data-dart data-dx={dx} data-dy={dy} cx="0" cy="0" />
                    ))}
                  </svg>
                  <dl class="rd-checks">
                    <div class="rd-check">
                      <dt>Test accuracy</dt>
                      <dd><span data-pt-acc>0.998</span><b class="pass" data-pt-acc-v>PASS</b></dd>
                    </div>
                    <div class="rd-check">
                      <dt>Restart agreement</dt>
                      <dd><span data-pt-agr>0.995</span><b class="pass" data-pt-agr-v>PASS</b></dd>
                    </div>
                    <div class="rd-check rd-check--bar">
                      <dt>Share on one near-constant coordinate</dt>
                      <dd><span data-pt-share>0.0%</span><span class="rd-sharebar"><i data-pt-sharebar></i></span></dd>
                    </div>
                    <div class="rd-check rd-check--truth">
                      <dt>Alignment with the true weights</dt>
                      <dd><span data-pt-aln>0.995</span><b class="pass" data-pt-aln-v>TRUE</b></dd>
                    </div>
                  </dl>
                </div>
                <div class="rd-pt-ctl">
                  <label class="rd-pt-l" for="rd-gain">
                    GAIN MULTIPLIER <b data-pt-c>c = 1</b>
                  </label>
                  <input id="rd-gain" class="rd-range" type="range" min="0" max="50" step="1" value="0" data-pt-range aria-describedby="rd-gain-cap" />
                  <div class="rd-pt-ticks" aria-hidden="true"><span>1</span><span>10⁻¹</span><span>10⁻²</span><span>10⁻³</span><span>10⁻⁴</span><span>10⁻⁵</span></div>
                  <button class="rd-btn rd-btn--ink" type="button" data-pt-std aria-pressed="true">Standardise coordinates: ON</button>
                </div>
                <p class="rd-verdict-s" data-pt-verdict aria-live="polite"></p>
                <p class="rd-honest" id="rd-gain-cap">
                  <b>Illustrative.</b> The share follows the paper’s Proposition 1 (odds grow as 1/c²), pinned to its
                  gain intervention: half the direction is on the coordinate at c = 10⁻², at least 0.999 at
                  10⁻⁵, and below 0.006 at every dose without standardisation. A fit fails when alignment is
                  below 0.95.
                </p>
              </section>
            )}
            {st.id === 'instrument' && instrument.results && (
              <section class="rd-bench" data-instrument aria-label="Concept-injection instrument audit">
                <div class="rd-c-head">
                  <span>▶ THE AUDIT · <span class="lime">THREE ASSUMPTIONS</span></span>
                  <span class="rd-c-q">NO REGIME HELD ALL THREE</span>
                </div>
                <div class="rd-gauges">
                  {instrumentChecks.map((c) => (
                    <div class="rd-gauge">
                      <div class="rd-gauge-top">
                        <span class="rd-gauge-k">{c.k}</span>
                        <span class="rd-gauge-x">✗ BREAKS</span>
                      </div>
                      <div class="rd-gauge-q">{c.q}</div>
                      <div class="rd-gauge-v">{c.v}</div>
                      <div class="rd-gauge-f">{c.fail}</div>
                    </div>
                  ))}
                </div>

                <div class="rd-heat-wrap">
                  <div class="rd-heat-h">
                    <span>WHICH SENTENCE WAS INJECTED? · LLAMA-3.1-8B · 10 OPTIONS, CHANCE 10%</span>
                    <div class="rd-seg" role="group" aria-label="Show accuracy for">
                      <button type="button" class="is-on" data-heat-mode="real" aria-pressed="true">Concept vector</button>
                      <button type="button" data-heat-mode="random" aria-pressed="false">Random, same norm</button>
                      <button type="button" data-heat-mode="gap" aria-pressed="false">Difference</button>
                    </div>
                  </div>
                  <div class="rd-heat" style={`--cols:${loc.strengths.length}`}>
                    <span class="rd-heat-corner">LAYER ↓ · STRENGTH →</span>
                    {loc.strengths.map((s) => <span class="rd-heat-col">α {s}</span>)}
                    {loc.layers.map((layer) => (
                      <>
                        <span class="rd-heat-row">L{layer}</span>
                        {locCells
                          .filter((c) => c.layer === layer)
                          .map((c) => (
                            <span
                              class={`rd-cell${c.primary ? ' is-primary' : ''}`}
                              data-cell
                              data-real={c.real}
                              data-random={c.random}
                              style={`--v:${c.real}`}
                            >
                              <b data-cell-v>{pct(c.real)}%</b>
                              {c.primary && <em>FILED</em>}
                            </span>
                          ))}
                      </>
                    ))}
                  </div>
                  <p class="rd-verdict-s rd-verdict-s--light" data-heat-verdict aria-live="polite">
                    The concept vector looks like it works: <b>97%</b> in the filed cell. Now switch to random vectors.
                  </p>
                </div>
                <p class="rd-honest">
                  <b>Real data.</b> Table 2 of the paper: 600 trials per cell and arm. “Random” is a direction of the
                  same norm carrying no concept.
                </p>
              </section>
            )}
            {st.id === 'missingmass' && mm.results && (
              <section class="rd-sim" data-mm aria-label="Capture–recapture simulator">
                <div class="rd-c-head rd-c-head--lime">
                  <span>▶ THE SIMULATOR · <span class="ink">{MM_N} PLANTED FAILURE MODES</span></span>
                  <span class="rd-c-q">SOME ARE MUCH HARDER TO FIND</span>
                </div>
                <div class="rd-sim-body">
                  <div class="rd-sim-grid" style={`--n:${MM_N}`} aria-hidden="true">
                    <span class="rd-sim-lab">FOUND BY</span>
                    {Array.from({ length: MM_N }, (_, i) => <span class="rd-sim-freq" data-mm-freq={i}></span>)}
                    {Array.from({ length: MM_K }, (_, r) => (
                      <>
                        <span class="rd-sim-lab" data-mm-runlab={r}>RUN {r + 1}</span>
                        {Array.from({ length: MM_N }, (_, i) => <span class="rd-sim-c" data-mm-c={`${r}-${i}`}></span>)}
                      </>
                    ))}
                    <span class="rd-sim-lab">FINDABILITY</span>
                    {Array.from({ length: MM_N }, (_, i) => <span class="rd-sim-p" data-mm-p={i}><i></i></span>)}
                  </div>

                  <div class="rd-sim-read">
                    <div class="rd-sim-stat">
                      <span class="k">RUNS</span><span class="v" data-mm-k>0</span>
                    </div>
                    <div class="rd-sim-stat">
                      <span class="k">FAILURE MODES FOUND</span><span class="v" data-mm-s>0</span>
                    </div>
                    <div class="rd-sim-stat">
                      <span class="k">FOUND BY ONE RUN ONLY</span><span class="v" data-mm-q1>0</span>
                    </div>
                    <div class="rd-sim-meter">
                      <div class="k">COVERAGE · ESTIMATED <b data-mm-chat>—</b> · TRUE <b data-mm-ctrue>—</b></div>
                      <div class="rd-meter"><i class="est" data-mm-cbar></i><i class="tru" data-mm-tbar></i></div>
                    </div>
                    <div class="rd-sim-meter">
                      <div class="k">HOW MANY EXIST · LOWER BOUND <b data-mm-chao>—</b> · TRUE <b data-mm-ntrue>{MM_N}</b></div>
                      <div class="rd-meter"><i class="est" data-mm-nbar></i><i class="tru" style="left:100%"></i></div>
                    </div>
                    <div class="rd-sim-meter">
                      <div class="k">NEW FINDS FROM <span data-mm-m>K</span> MORE RUNS · PREDICTED <b data-mm-dhat>—</b> · EXPECTED <b data-mm-dtrue>—</b></div>
                    </div>
                  </div>
                </div>
                <div class="rd-verdict rd-verdict--lime">
                  <p class="rd-v-txt" data-mm-verdict aria-live="polite">Run the audit. Each run finds each failure mode with its own probability.</p>
                  <div class="rd-v-btns">
                    <button class="rd-btn rd-btn--lime" type="button" data-mm-run>Run an audit</button>
                    <button class="rd-btn" type="button" data-mm-run5>+5 runs</button>
                    <button class="rd-btn" type="button" data-mm-reveal aria-pressed="false">Show what was missed</button>
                    <button class="rd-btn" type="button" data-mm-new>New model</button>
                  </div>
                </div>
                <p class="rd-honest rd-honest--ink">
                  <b>Simulated in your browser.</b> These are toy numbers, not the study’s results. It uses the same
                  estimators as the repo’s library: Chao–Jost coverage, bias-corrected Chao2 as a lower bound, and
                  the Chao et al. extrapolation for new finds.
                </p>
              </section>
            )}

            <div class="rd-p-foot">
              <span class="rd-stamp">{st.name}</span>
              <span class="rd-stamp rd-stamp--dev">{st.status}</span>
              <span class="rd-p-paper">PAPER · <i>{st.title}</i></span>
              {st.links?.github && <a class="rd-src" href={st.links.github} target="_blank" rel="noopener">SOURCE ↗</a>}
            </div>
            {st.source && <div class="rd-srcline rd-srcline--flat">{st.source}</div>}

            <details class="rd-more">
              <summary><span class="rd-more-o">Read the long version</span><span class="rd-more-c">Fold it back up</span> <span aria-hidden="true">↓</span></summary>
              <div class="rd-more-body">
                {st.body.map((para) => <p set:html={para} />)}
                <p class="rd-more-by">{st.byline}</p>
              </div>
            </details>
            {i < research.length - 1 && (
              <a class="rd-next" href={`#study-${research[i + 1].id}`}>
                <span class="rd-next-k">NEXT STUDY · No.{research[i + 1].no}</span>
                <span class="rd-next-name">{research[i + 1].name}</span>
                <span class="rd-next-q">{research[i + 1].headline}</span>
                <span class="rd-next-arr" aria-hidden="true">↓</span>
              </a>
            )}
          </article>
        );
      })}
    </div>

    <!-- ================= ALSO ON THE RECORD ================= -->
    {also.length > 0 && (
      <div class="rd-also">
        <div class="rd-also-h">Also on the record</div>
        <div class="rd-also-row">
          {also.map((e) => (
            <span class="rd-chip">
              {e.org} · <b>{e.role}</b>{e.metric && <> · {e.metric}</>} · {e.dates}
            </span>
          ))}
        </div>
      </div>
    )}
  </div>

  <script type="application/json" id="rd-culprit-data" set:html={JSON.stringify(culpritCase)} />
</section>

<style>
  /* ============================================================ RESEARCH DESK */
  .research {
    --bink: #141414;
    --bcream: #f7f5f1;
    --bcream2: #efece4;
    --bred: #ed1c24;
    --bred2: #ff5247;
    --blime: #b4ff2e;
    --bgray: #928b80;
    --bok: #1a7f37;
    --fd: "Press Display", sans-serif;
    --fm: "Martian Mono", monospace;
    --fi: "Fraunces", serif;
    background-color: var(--paper);
    background-image: var(--grid-strips);
    background-size: var(--grid-size) var(--grid-size);
    background-position: -1px -1px;
  }

  /* ---- section heading (white on red, like the other sections) ---- */
  .research .rd-head {
    position: relative;
    gap: 0;
    max-width: min(100%, 1500px);
    margin: 0 auto clamp(30px, 4vw, 56px);
    align-items: flex-start;
    text-align: left;
  }
  .research .kicker {
    margin-bottom: 10px;
    font-family: var(--fm);
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: lowercase;
    color: rgba(255, 255, 255, 0.78);
  }
  .research .kicker::before { content: '// '; color: #fff; }
  .rd-title {
    font-family: var(--fd);
    font-weight: 700;
    text-transform: uppercase;
    color: #fff;
    line-height: 0.82;
    letter-spacing: 0.005em;
    font-size: clamp(2.6rem, 11vw, 8rem);
  }
  .rd-em { font-style: normal; color: transparent; -webkit-text-stroke: 2px #fff; }
  .rd-lede {
    margin: 16px 0 0;
    max-width: 66ch;
    font-family: var(--fm);
    font-size: 12.5px;
    letter-spacing: 0.04em;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.82);
  }
  .rd-lede b { color: #fff; font-weight: 700; }

  /* ---- the cream sheet ---- */
  .rd-sheet {
    max-width: min(100%, 1500px);
    margin: 0 auto;
    background: var(--bcream);
    border: 5px solid var(--bink);
    box-shadow: 12px 12px 0 var(--bink);
    color: var(--bink);
    font-family: var(--fi);
    padding: clamp(14px, 2.4vw, 30px) clamp(14px, 2.6vw, 34px) clamp(22px, 3vw, 38px);
  }

  .rd-folio {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 4px 16px; padding-bottom: 10px;
    border-bottom: 3px solid var(--bink); margin-bottom: 18px;
    font-family: var(--fm); font-size: 9.5px; font-weight: 500;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--bgray);
  }
  .rd-folio b { color: var(--bink); font-weight: 700; }
  .rd-folio-c { color: var(--bred); font-weight: 700; }

  /* ============================================================ CORRECTIONS */

  /* ---- article furniture ---- */
  .rd-kicker {
    font-family: var(--fm); font-size: 9px; font-weight: 700;
    letter-spacing: 0.2em; text-transform: uppercase; color: var(--bred); margin-bottom: 9px;
  }
  .rd-headline {
    font-family: var(--fd); font-weight: 500;
    font-size: clamp(1.8rem, 5vw, 3.8rem); line-height: 0.9;
    text-transform: uppercase; letter-spacing: 0.01em; margin: 0;
  }
  .rd-deck {
    font-family: var(--fi); font-style: italic;
    font-size: clamp(1rem, 1.6vw, 1.25rem); line-height: 1.4; margin-top: 12px; max-width: 66ch;
  }
  .rd-stamp {
    background: var(--bred); color: var(--bcream); border: 2px solid var(--bink);
    box-shadow: 2px 2px 0 var(--bink); padding: 3px 7px; letter-spacing: 0.14em;
    font-family: var(--fm); font-size: 9.5px; font-weight: 700; text-transform: uppercase;
  }
  .rd-stamp--dev { background: var(--bink); color: var(--blime); }
  .rd-stamp--lime { background: var(--blime); color: var(--bink); border-color: var(--blime); box-shadow: none; }
  .rd-stamp--cream { background: transparent; color: var(--bcream); border-color: var(--bcream); box-shadow: none; }
  .rd-src { color: var(--bred); border-bottom: 1px solid currentColor; font-family: var(--fm); font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-decoration: none; }
  .rd-src:hover { color: var(--bink); }
  .rd-src--lime { color: var(--blime); }
  .rd-src--lime:hover { color: var(--bcream); }

  /* ============================================================ CONSOLE (shared) */ .rd-bench {
    border: 3px solid var(--bink); box-shadow: 8px 8px 0 var(--bink);
    background: var(--bink); margin: 18px 0 0;
  }
  .rd-c-head {
    display: flex; align-items: center; justify-content: space-between; gap: 6px 12px; flex-wrap: wrap;
    padding: 9px 12px; color: var(--bcream); border-bottom: 3px solid var(--bcream);
    font-family: var(--fm); font-size: 9px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase;
  }
  .rd-c-head .lime { color: var(--blime); }
  .rd-c-q { color: rgba(247, 245, 241, 0.6); }
  .rd-c-head--lime { background: var(--blime); color: var(--bink); border-bottom-color: var(--bink); }
  .rd-c-head--lime .ink { color: var(--bink); }
  .rd-c-head--lime .rd-c-q { color: rgba(20, 20, 20, 0.6); }

  /* ---- the lattice ---- */

  .rd-verdict { background: var(--bink); color: var(--bcream); padding: 12px; display: grid; grid-template-columns: 1fr auto; gap: 12px; align-items: center; }
  .rd-v-txt { font-family: var(--fm); font-size: 10px; line-height: 1.65; letter-spacing: 0.03em; margin: 0; min-height: 3.3em; }
  .rd-v-txt b { color: var(--blime); }
  .rd-v-txt .warn { color: var(--bred2); font-weight: 700; }
  .rd-v-btns { display: flex; gap: 8px; flex-wrap: wrap; }
  .rd-btn {
    font-family: var(--fm); font-size: 8.5px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
    background: transparent; color: var(--bcream); border: 2px solid var(--bcream); padding: 8px 11px;
    cursor: pointer; transition: background 0.12s, color 0.12s;
  }
  .rd-btn:hover { background: var(--bcream); color: var(--bink); }
  .rd-btn:focus-visible { outline: 3px solid var(--blime); outline-offset: 2px; }
  .rd-btn--pri { background: var(--bred); border-color: var(--bred); }
  .rd-btn--pri:hover { background: var(--bred2); color: var(--bcream); }
  .rd-btn--lime { background: var(--blime); border-color: var(--blime); color: var(--bink); }
  .rd-btn--lime:hover { background: var(--bcream); border-color: var(--bcream); }
  .rd-btn--ink { color: var(--bcream); border-color: var(--bcream); }
  .rd-btn--ink[aria-pressed='false'] { color: var(--blime); border-color: var(--blime); }

  .rd-honest {
    margin: 0; font-family: var(--fm); font-size: 7.5px; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--bgray); padding: 8px 12px;
    background: var(--bcream2); border-top: 2px dashed rgba(20, 20, 20, 0.35); line-height: 1.6;
  }
  .rd-honest b { color: var(--bink); }
  .rd-honest--ink { background: #1f1f1f; border-top-color: rgba(247, 245, 241, 0.25); color: rgba(247, 245, 241, 0.55); }
  .rd-honest--ink b { color: var(--blime); }

  /* ---- lead body + sidebar ---- */
  .rd-srcline {
    font-family: var(--fm); font-size: 7.5px; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--bgray); padding: 7px 10px; border-top: 1px dashed rgba(20, 20, 20, 0.3); line-height: 1.5;
  }
  .rd-srcline--flat { padding: 8px 0 0; margin-top: 12px; }
  .rd-srcline--ink { color: rgba(247, 245, 241, 0.5); border-top-color: rgba(247, 245, 241, 0.25); padding: 8px 0 0; margin-top: 14px; }

  /* ---- three jobs scorecard ---- */
  .rd-jobs { margin-top: 18px; border: 2px solid var(--bink); background: var(--bcream2); box-shadow: 5px 5px 0 var(--bink); }
  .rd-jobs-h {
    display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 4px 16px;
    padding: 8px 12px; border-bottom: 2px solid var(--bink);
  }
  .rd-jobs-t { font-family: var(--fd); font-size: 1.3rem; text-transform: uppercase; letter-spacing: 0.02em; }
  .rd-jobs-s { font-family: var(--fm); font-size: 8.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--bgray); }
  .rd-jobs-row { display: grid; grid-template-columns: repeat(3, 1fr); }
  .rd-job { padding: 12px; }
  .rd-job + .rd-job { border-left: 1px solid rgba(20, 20, 20, 0.25); }
  .rd-job-top { display: flex; justify-content: space-between; align-items: center; }
  .rd-job-n { font-family: var(--fm); font-size: 8.5px; font-weight: 700; letter-spacing: 0.16em; color: var(--bgray); }
  .rd-verd { font-family: var(--fm); font-size: 8.5px; font-weight: 700; letter-spacing: 0.16em; padding: 3px 7px; border: 2px solid var(--bink); box-shadow: 2px 2px 0 var(--bink); }
  .rd-verd--works { background: var(--bok); color: #fff; }
  .rd-verd--capped { background: var(--blime); color: var(--bink); }
  .rd-verd--fails { background: var(--bred); color: var(--bcream); }
  .rd-job-name { font-family: var(--fd); font-size: 1.5rem; text-transform: uppercase; line-height: 1; margin: 8px 0 10px; }
  .rd-jbar + .rd-jbar { margin-top: 8px; }
  .rd-jbar-t { font-family: var(--fm); font-size: 8.5px; letter-spacing: 0.04em; line-height: 1.45; }
  .rd-jbar-t b { font-family: var(--fd); font-size: 1.35rem; font-weight: 400; letter-spacing: 0.01em; color: var(--bred); margin-right: 4px; }
  .rd-jbar.is-base .rd-jbar-t b { color: var(--bink); }
  .rd-jbar-b { height: 8px; border: 1.5px solid var(--bink); background: var(--bcream); margin-top: 3px; position: relative; }
  .rd-jbar-b i { position: absolute; inset: 0 auto 0 0; background: var(--bred); display: block; }
  .rd-jbar.is-base .rd-jbar-b i { background: repeating-linear-gradient(45deg, var(--bink) 0 2px, var(--bcream) 2px 5px); }

  /* ============================================================ SECONDARY STUDIES */

  /* ---- the precision / trueness bench ---- */
  .rd-pt { background: var(--bcream); display: grid; grid-template-columns: minmax(150px, 42%) 1fr; gap: 14px; padding: 14px 12px; align-items: center; border-bottom: 3px solid var(--bink); }
  .rd-board { width: 100%; height: auto; display: block; }
  .rd-board .ring { fill: none; stroke: rgba(20, 20, 20, 0.35); stroke-width: 1.2; }
  .rd-board .ring:first-child { fill: var(--bcream2); stroke: var(--bink); stroke-width: 2.5; }
  .rd-board .cross { stroke: rgba(20, 20, 20, 0.15); stroke-width: 1; }
  .rd-board .bull { fill: var(--bok); }
  .rd-board .bull-t { font-family: var(--fm); font-size: 7.5px; font-weight: 700; letter-spacing: 0.14em; fill: var(--bok); }
  .rd-board .dart { fill: var(--bred); stroke: var(--bink); stroke-width: 1.5; transition: cx 0.18s ease, cy 0.18s ease; }
  .rd-checks { margin: 0; display: grid; gap: 7px; }
  .rd-check { border: 2px solid var(--bink); background: var(--bcream2); padding: 6px 8px; }
  .rd-check dt { font-family: var(--fm); font-size: 7.5px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--bgray); }
  .rd-check dd { margin: 3px 0 0; display: flex; align-items: center; justify-content: space-between; gap: 8px; font-family: var(--fd); font-size: 1.45rem; line-height: 1; }
  .rd-check dd b { font-family: var(--fm); font-size: 8px; letter-spacing: 0.14em; padding: 3px 6px; border: 2px solid var(--bink); }
  .rd-check dd b.pass { background: var(--bok); color: #fff; }
  .rd-check dd b.fail { background: var(--bred); color: var(--bcream); }
  .rd-check--truth { border-width: 3px; box-shadow: 3px 3px 0 var(--bink); }
  .rd-check--bar dd { justify-content: flex-start; }
  .rd-sharebar { flex: 1; height: 10px; border: 1.5px solid var(--bink); background: var(--bcream); position: relative; }
  .rd-sharebar i { position: absolute; inset: 0 auto 0 0; width: 0; background: var(--bred); display: block; }
  .rd-pt-ctl { background: var(--bink); padding: 12px; display: grid; grid-template-columns: 1fr auto; gap: 6px 14px; align-items: center; }
  .rd-pt-l { grid-column: 1 / -1; font-family: var(--fm); font-size: 8.5px; font-weight: 700; letter-spacing: 0.14em; color: rgba(247, 245, 241, 0.7); }
  .rd-pt-l b { color: var(--blime); margin-left: 6px; }
  .rd-range { width: 100%; accent-color: var(--blime); grid-column: 1; margin: 0; }
  .rd-pt-ticks { grid-column: 1; grid-row: 3; display: flex; justify-content: space-between; font-family: var(--fm); font-size: 7.5px; color: rgba(247, 245, 241, 0.5); letter-spacing: 0.04em; }
  .rd-pt-ctl .rd-btn { grid-column: 2; grid-row: 2 / span 2; }
  .rd-verdict-s { margin: 0; background: var(--bink); color: var(--bcream); padding: 0 12px 12px; font-family: var(--fm); font-size: 9.5px; line-height: 1.6; letter-spacing: 0.03em; min-height: 3.2em; }
  .rd-verdict-s b { color: var(--blime); }
  .rd-verdict-s .warn { color: var(--bred2); font-weight: 700; }
  .rd-verdict-s--light { background: transparent; color: var(--bink); padding: 10px 0 0; min-height: 0; }
  .rd-verdict-s--light b { color: var(--bred); }

  /* ---- the instrument audit ---- */
  .rd-gauges { display: grid; grid-template-columns: repeat(3, 1fr); background: var(--bcream); border-bottom: 3px solid var(--bink); }
  .rd-gauge { padding: 10px; }
  .rd-gauge + .rd-gauge { border-left: 2px solid var(--bink); }
  .rd-gauge-top { display: flex; justify-content: space-between; align-items: center; gap: 6px; }
  .rd-gauge-k { font-family: var(--fd); font-size: 1.3rem; letter-spacing: 0.03em; }
  .rd-gauge-x { font-family: var(--fm); font-size: 7px; font-weight: 700; letter-spacing: 0.12em; background: var(--bred); color: var(--bcream); padding: 2px 5px; }
  .rd-gauge-q { font-family: var(--fi); font-style: italic; font-size: 0.92rem; line-height: 1.25; margin-top: 4px; min-height: 2.5em; }
  .rd-gauge-v { font-family: var(--fd); font-size: 1.75rem; color: var(--bred); line-height: 1; margin-top: 6px; }
  .rd-gauge-f { font-family: var(--fm); font-size: 7.5px; letter-spacing: 0.05em; text-transform: uppercase; line-height: 1.5; margin-top: 5px; }

  .rd-heat-wrap { background: var(--bcream2); padding: 12px; }
  .rd-heat-h { display: flex; justify-content: space-between; align-items: center; gap: 8px 12px; flex-wrap: wrap; font-family: var(--fm); font-size: 8px; font-weight: 700; letter-spacing: 0.12em; color: var(--bgray); margin-bottom: 10px; }
  .rd-seg { display: inline-flex; border: 2px solid var(--bink); }
  .rd-seg button { font-family: var(--fm); font-size: 8px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; background: var(--bcream); color: var(--bink); border: none; padding: 6px 8px; cursor: pointer; }
  .rd-seg button + button { border-left: 2px solid var(--bink); }
  .rd-seg button.is-on { background: var(--bink); color: var(--blime); }
  .rd-seg button:focus-visible { outline: 3px solid var(--bred); outline-offset: 1px; }
  .rd-heat { display: grid; grid-template-columns: auto repeat(var(--cols), 1fr); gap: 4px; }
  .rd-heat-corner, .rd-heat-col, .rd-heat-row { font-family: var(--fm); font-size: 8px; font-weight: 700; letter-spacing: 0.1em; color: var(--bgray); display: flex; align-items: center; }
  .rd-heat-col { justify-content: center; }
  .rd-heat-corner { font-size: 6.5px; padding-right: 6px; }
  .rd-cell {
    position: relative; height: 38px; display: flex; align-items: center; justify-content: center;
    border: 2px solid var(--bink);
    background: color-mix(in srgb, var(--bred) calc(var(--v) * 100%), var(--bcream));
    transition: background 0.2s ease;
  }
  .rd-cell b { font-family: var(--fd); font-weight: 400; font-size: 1.15rem; color: var(--bink); }
  .rd-cell.is-dark b { color: #fff; }
  .rd-cell.is-neg { background: repeating-linear-gradient(45deg, var(--bcream) 0 4px, rgba(20, 20, 20, 0.12) 4px 7px); }
  .rd-cell.is-primary { outline: 3px solid var(--bink); outline-offset: 2px; box-shadow: 0 0 0 5px var(--blime); }
  .rd-cell em { position: absolute; top: -9px; right: -6px; font-family: var(--fm); font-style: normal; font-size: 6.5px; font-weight: 700; letter-spacing: 0.12em; background: var(--bink); color: var(--blime); padding: 2px 4px; }

  /* ============================================================ WORK-IN-PROGRESS BAND */

  .rd-sim { border: 3px solid var(--blime); background: var(--bink); align-self: start; }
  .rd-sim-body { padding: 12px; display: grid; gap: 14px; }
  .rd-sim-grid { display: grid; grid-template-columns: auto repeat(var(--n), minmax(0, 1fr)); gap: 2px; align-items: center; }
  .rd-sim-lab { font-family: var(--fm); font-size: 6.5px; font-weight: 700; letter-spacing: 0.1em; color: rgba(247, 245, 241, 0.45); padding-right: 6px; white-space: nowrap; }
  .rd-sim-lab.is-live { color: var(--blime); }
  .rd-sim-c { aspect-ratio: 1; border-radius: 50%; background: rgba(247, 245, 241, 0.08); transform: scale(0.45); transition: transform 0.15s ease, background 0.15s ease; }
  .rd-sim-c.is-hit { background: var(--bcream); transform: scale(1); }
  .rd-sim-c.is-hit.is-single { background: var(--bred2); }
  .rd-sim-c.is-miss { background: transparent; box-shadow: inset 0 0 0 1px rgba(247, 245, 241, 0.12); }
  .rd-sim-freq { font-family: var(--fm); font-size: 7px; font-weight: 700; text-align: center; color: rgba(247, 245, 241, 0.7); min-height: 1em; }
  .rd-sim-freq.is-single { color: var(--bred2); }
  .rd-sim-p { height: 22px; position: relative; border-bottom: 1px solid rgba(247, 245, 241, 0.2); opacity: 0; transition: opacity 0.2s ease; }
  .rd-sim-p i { position: absolute; left: 15%; right: 15%; bottom: 0; height: 0; background: var(--bcream); display: block; }
  .rd-sim-p.is-missed i { background: repeating-linear-gradient(45deg, var(--blime) 0 2px, transparent 2px 4px); }
  .rd-sim.is-revealed .rd-sim-p { opacity: 1; }
  .rd-sim-read { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .rd-sim-stat { border: 1.5px solid rgba(247, 245, 241, 0.3); padding: 6px 8px; }
  .rd-sim-stat .k, .rd-sim-meter .k { display: block; font-family: var(--fm); font-size: 7px; font-weight: 700; letter-spacing: 0.12em; color: rgba(247, 245, 241, 0.55); }
  .rd-sim-stat .v { display: block; font-family: var(--fd); font-size: 1.7rem; line-height: 1.05; color: var(--bcream); }
  .rd-sim-meter { grid-column: 1 / -1; }
  .rd-sim-meter .k b { color: var(--blime); font-weight: 700; margin: 0 2px; }
  .rd-meter { position: relative; height: 12px; margin-top: 5px; border: 1.5px solid rgba(247, 245, 241, 0.5); }
  .rd-meter .est { position: absolute; inset: 0 auto 0 0; width: 0; background: var(--blime); display: block; transition: width 0.2s ease; }
  .rd-meter .tru { position: absolute; top: -5px; bottom: -5px; width: 3px; margin-left: -1.5px; left: 0; background: var(--bred2); display: block; transition: left 0.2s ease; }
  .rd-verdict--lime { border-top: 3px solid var(--blime); }

  /* ---- also strip ---- */
  .rd-also { margin-top: 28px; border-top: 3px solid var(--bink); padding-top: 12px; }
  .rd-also-h { font-family: var(--fd); font-weight: 500; font-size: 1.15rem; text-transform: uppercase; letter-spacing: 0.03em; margin-bottom: 9px; }
  .rd-also-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .rd-chip {
    border: 2px solid var(--bink); background: var(--bcream2); box-shadow: 3px 3px 0 var(--bink);
    padding: 7px 10px; font-family: var(--fm); font-size: 8.5px; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
  }
  .rd-chip b { color: var(--bred); }

  /* ---- responsive ---- */
  @media (max-width: 1180px) {
  }
  @media (max-width: 980px) {
  }
  @media (max-width: 900px) {
    .rd-jobs-row { grid-template-columns: 1fr; }
    .rd-job + .rd-job { border-left: none; border-top: 1px solid rgba(20, 20, 20, 0.25); }
  }
  @media (max-width: 620px) {
    .rd-verdict { grid-template-columns: 1fr; }
    .rd-sheet { box-shadow: 8px 8px 0 var(--bink); border-width: 4px; }
    .rd-pt { grid-template-columns: 1fr; }
    .rd-board { max-width: 240px; margin: 0 auto; }
    .rd-pt-ctl { grid-template-columns: 1fr; }
    .rd-pt-ctl .rd-btn { grid-column: 1; grid-row: auto; }
    .rd-gauges { grid-template-columns: 1fr; }
    .rd-gauge + .rd-gauge { border-left: none; border-top: 2px solid var(--bink); }
    .rd-gauge-q { min-height: 0; }
    .rd-sim-read { grid-template-columns: 1fr 1fr; }
    .rd-sim-stat:first-child { grid-column: 1 / -1; }
  }
  @media (prefers-reduced-motion: reduce) { .rd-board .dart, .rd-cell, .rd-sim-c, .rd-meter .est, .rd-meter .tru, .rd-sim-p { transition: none; }
  }

  /* ============================================================ THE DESK: tabs + panels */
  /* the rail: which study you're reading, pinned under the nav as you scroll
     down the desk; each entry jumps to its study */
  .rd-rail {
    position: sticky;
    top: 86px;
    z-index: 6;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 3px solid var(--bink);
    background: var(--bcream);
    box-shadow: 0 6px 0 rgba(20, 20, 20, 0.12);
    margin-bottom: clamp(18px, 2.4vw, 28px);
  }
  .rd-rail-i {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 9px 12px 11px;
    border-right: 2px solid var(--bink);
    color: var(--bink);
    text-decoration: none;
    min-width: 0;
    transition: background 0.25s ease, color 0.25s ease;
  }
  .rd-rail-i:last-child { border-right: 0; }
  .rd-rail-i:hover { background: var(--bcream2); }
