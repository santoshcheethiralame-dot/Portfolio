<script>
  // THE DESK: the rail follows the study under the viewport's mid-line (an
  // observer, so scrolling measures nothing) and marks the ones already read.
  (function () {
    try {
      const items = Array.from(document.querySelectorAll<HTMLElement>('#research .rd-rail-i'));
      const panels = Array.from(document.querySelectorAll<HTMLElement>('#research .rd-panel'));
      if (!items.length || typeof IntersectionObserver === 'undefined') return;
      const on = new Set<string>();
      const io = new IntersectionObserver((es) => {
        es.forEach((en) => { const id = (en.target as HTMLElement).dataset.study || ''; if (en.isIntersecting) on.add(id); else on.delete(id); });
        let cur = -1;
        panels.forEach((p, i) => { if (on.has(p.dataset.study || '')) cur = i; });
        if (cur < 0) return;
        items.forEach((it, i) => { it.classList.toggle('is-on', i === cur); it.classList.toggle('is-done', i < cur); });
      }, { rootMargin: '-45% 0px -54% 0px' });
      panels.forEach((p) => io.observe(p));
    } catch (e) { /* the rail stays a list of links */ }
  })();

  // AUTOPLAY: each figure plays itself while it's on screen. Touch it and it's
  // yours; it picks back up after 20 s left alone. Reduced motion: never plays.
  const REDUCE_AUTO = matchMedia('(prefers-reduced-motion: reduce)').matches;
  function autoplay(root: HTMLElement | null, step: () => void, every: number) {
    if (!root || REDUCE_AUTO) return;
    const chip = document.createElement('span');
    chip.className = 'rd-auto';
    chip.setAttribute('aria-hidden', 'true');
    chip.innerHTML = '<i></i><b>PLAYING · TOUCH TO TAKE OVER</b>';
    root.appendChild(chip);
    const label = chip.querySelector('b') as HTMLElement;
    let took = 0, vis = false;
    const take = () => {
      took = performance.now();
      chip.classList.add('is-yours');
      label.textContent = 'YOURS · REPLAYS WHEN LEFT ALONE';
    };
    root.addEventListener('pointerdown', take, true);
    root.addEventListener('keydown', take, true);
    new IntersectionObserver((es) => es.forEach((en) => { vis = en.isIntersecting; }), { threshold: 0.3 }).observe(root);
    window.setInterval(() => {
      if (!vis || document.hidden || (window as any).__pressFreeze) return;
      if (took) {
        if (performance.now() - took < 20000) return;
        took = 0;
        chip.classList.remove('is-yours');
        label.textContent = 'PLAYING · TOUCH TO TAKE OVER';
      }
      step();
    }, every);
  }

  /* ===================== 01 · the lineup ===================== */
  // Pick passages (or tap a cell of the pair grid) and the model answers from that
  // context. Cells and case files fill in as you test; "Show me" fills everything.
  (function () {
    'use strict';
    try {
      const root = document.querySelector<HTMLElement>('[data-culprit]');
      const dataEl = document.getElementById('rd-culprit-data');
      if (!root || !dataEl) return;
      const D = JSON.parse(dataEl.textContent || '{}');
      const ALL: string = D.passages.map((p: { id: string }) => p.id).join('');
      const suff = new Set<string>(D.sufficient);
      const mins: string[] = D.minimal;
      const viol: string[][] = D.violations;
      const $ = <T extends Element = HTMLElement>(sel: string) => root.querySelector(sel) as T;
      const chunks = Array.from(root.querySelectorAll<HTMLElement>('[data-chunk]'));
      const cells = new Map<string, HTMLElement>();
      root.querySelectorAll<HTMLElement>('[data-node]').forEach((c) => cells.set(c.dataset.node || '', c));
      const files = new Map<string, HTMLElement>();
      root.querySelectorAll<HTMLElement>('[data-file]').forEach((f) => files.set(f.dataset.file || '', f));
      const twists = new Map<string, HTMLElement>();
      root.querySelectorAll<HTMLElement>('[data-twist]').forEach((t) => twists.set(t.dataset.twist || '', t));
      const ansBox = $('[data-ansbox]'), ansVal = $('[data-ansval]'), ansTag = $('[data-anstag]');
      const verdict = $('[data-verdict]'), inCount = $('[data-incount]'), foundEl = $('[data-found]');
      const REDUCE = matchMedia('(prefers-reduced-motion: reduce)').matches;

      let selected = new Set<string>();
      const seen = new Set<string>();
      const found = new Set<string>();
      let revealed = false;

      const keyOf = () => ALL.split('').filter((c) => selected.has(c)).join('');
      const fmt = (k: string) => k.split('').join(' + ');
      const queried = (k: string) => k.length <= D.bound || k === ALL;

      function paint() {
        cells.forEach((c, k) => {
          const known = revealed || seen.has(k);
          c.classList.toggle('is-known', known);
          c.classList.toggle('is-err', known && suff.has(k));
          c.classList.toggle('is-min', known && mins.indexOf(k) >= 0);
          c.classList.toggle('is-cur', k === keyOf());
        });
        files.forEach((f, k) => f.classList.toggle('is-found', revealed || found.has(k)));
        twists.forEach((t, k) => t.classList.toggle('is-seen', revealed || seen.has(k)));
        const n = revealed ? mins.length : found.size;
        foundEl.textContent = String(n);
        root.classList.toggle('is-solved', n === mins.length);
      }

      let flip = 0;
      function setAns(val: string, tag: string, cls: string) {
        ansBox.className = 'cl-out ' + cls;
        ansTag.textContent = tag;
        if (REDUCE) { ansVal.textContent = val; return; }
        // a beat of "thinking" before the answer lands
        const G = 'ABCDEFGHJKLMNPQRSTUVWXYZ0123456789';
        const id = ++flip, t0 = performance.now();
        const run = (now: number) => {
          if (id !== flip) return;
          const k = Math.min(1, Math.max(0, (now - t0) / 320)), rev = Math.floor(k * val.length);
          let out = '';
          for (let i = 0; i < val.length; i++) out += i < rev || val[i] === ' ' ? val[i] : G[(Math.random() * G.length) | 0];
          ansVal.textContent = out;
          if (k < 1) requestAnimationFrame(run);
        };
        requestAnimationFrame(run);
      }

      function update() {
        const k = keyOf(), size = k.length;
        if (queried(k) && size) seen.add(k);
        chunks.forEach((c) => {
          const on = selected.has(c.dataset.chunk || '');
          c.classList.toggle('is-in', on);
          c.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        inCount.textContent = String(size);
        let msg = '';
        if (!size) {
          setAns('—', 'SHOW IT SOME PASSAGES', 'is-none');
          msg = 'Start with one passage. Then try two.';
        } else if (!queried(k)) {
          setAns('?', 'NOT ASKED IN THIS RUN', 'is-none');
          msg = 'This run stopped at three passages, so sets of four or five were never asked. (The paper’s main runs ask all 63.)';
        } else if (suff.has(k)) {
          setAns(D.wrong, '✗ REPEATS THE ERROR', 'is-wrong');
          if (k === ALL) msg = 'All six: the original mistake. Now take it apart.';
          else if (mins.indexOf(k) >= 0) {
            found.add(k);
            msg = found.size === mins.length
              ? '<b>All three found.</b> B is in every one, but B alone isn’t enough. There’s no single culprit to name.'
              : '<b>' + fmt(k) + '</b> is a culprit set: it repeats the error and nothing smaller does. ' + found.size + ' of ' + mins.length + '.';
          } else {
            const inner = mins.filter((m) => m.split('').every((c) => k.indexOf(c) >= 0));
            msg = 'Repeats it, but only because <b>' + inner.map(fmt).join(', ') + '</b> is inside. Look for smaller.';
          }
        } else {
          const known = D.answers[k];
          if (known && known === D.gold) setAns(known, '✓ RIGHT ANSWER', 'is-right');
          else if (known) setAns(known, '✗ A DIFFERENT MISTAKE', 'is-other');
          else setAns('something else', 'DOESN’T REPEAT IT', 'is-none');
          const broke = viol.filter((v) => v[1] === k)[0];
          if (broke) {
            const added = k.split('').filter((c) => broke[0].indexOf(c) < 0)[0];
            msg = '<b>Plot twist.</b> ' + fmt(broke[0]) + ' repeated the error; adding ' + added + ' ' +
              (known === D.gold ? 'fixes it.' : known ? 'turns it into a different mistake.' : 'makes it stop.') +
              ' More context can undo an error, which is why “remove the culprit” fails.';
          } else if (size === 1) {
            msg = k === 'B'
              ? 'Not even the film’s own article does it alone. True for <b>49%</b> of the 603 errors studied.'
              : 'One passage alone doesn’t do it. Try pairs.';
          } else msg = 'Not this one. Keep looking.';
        }
        verdict.innerHTML = msg;
        paint();
      }

      chunks.forEach((c) => c.addEventListener('click', () => {
        const id = c.dataset.chunk || '';
        if (selected.has(id)) selected.delete(id); else selected.add(id);
        update();
      }));
      cells.forEach((c, k) => c.addEventListener('click', () => { selected = new Set(k.split('')); update(); }));
      $('[data-full]')?.addEventListener('click', () => { selected = new Set(ALL.split('')); update(); });
      $('[data-reveal]')?.addEventListener('click', () => {
        revealed = true;
        verdict.innerHTML = '<b>The whole picture.</b> Three culprit sets, all built on B; no single passage repeats the error; and adding a passage can undo it.';
        paint();
      });
      $('[data-reset]')?.addEventListener('click', () => {
        selected = new Set(); seen.clear(); found.clear(); revealed = false;
        update();
      });
      update();
      // the walk-through: B alone, the three culprit pairs, the twists, all six
      const DEMO = ['B', 'AB', 'BC', 'BE', 'ABD', 'ABF', 'ABCDEF'];
      let di = 0;
      autoplay(root, () => {
        if (di === 0) { seen.clear(); found.clear(); revealed = false; }
        selected = new Set(DEMO[di].split(''));
        update();
        di = (di + 1) % DEMO.length;
      }, 2300);
    } catch (e) { /* lineup enhancement failed: the markup stays readable */ }
  })();

  /* ===================== 02 · precision vs trueness ===================== */
  (function () {
    'use strict';
    try {
      var root = document.querySelector('[data-precise]');
      if (!root) return;
      var q = function (s: string) { return root!.querySelector(s) as HTMLElement; };
      var range = q('[data-pt-range]') as HTMLInputElement;
      var stdBtn = q('[data-pt-std]');
      var darts = Array.prototype.slice.call(root.querySelectorAll('[data-dart]')) as SVGCircleElement[];
      var standardise = true;

      function setCheck(valSel: string, vSel: string, val: string, ok: boolean, okTxt: string, badTxt: string) {
        q(valSel).textContent = val;
        var b = q(vSel);
        b.textContent = ok ? okTxt : badTxt;
        b.className = ok ? 'pass' : 'fail';
      }

      function update() {
        var lc = -Number(range.value) / 10; // log10 of the gain multiplier
        var c = Math.pow(10, lc);
        // Proposition 1: odds(share) scale as 1/c^2. Pinned so the share is 1/2 at c = 1e-2.
        var odds = 1e-4 / (c * c);
        var s = standardise ? odds / (1 + odds) : 0.0004;
        var agree = standardise ? 0.995 + 0.005 * s - 1.0 * s * (1 - s) : 0.995;
        var align = Math.max(0.016, 0.995 * Math.sqrt(1 - s));
        var acc = 0.998;

        q('[data-pt-c]').textContent = lc === 0 ? 'c = 1' : 'c = 10^' + lc.toFixed(1);
        setCheck('[data-pt-acc]', '[data-pt-acc-v]', acc.toFixed(3), true, 'PASS', 'FAIL');
        setCheck('[data-pt-agr]', '[data-pt-agr-v]', agree.toFixed(3), agree >= 0.9, 'PASS', 'DIPS');
        setCheck('[data-pt-aln]', '[data-pt-aln-v]', align.toFixed(3), align >= 0.95, 'TRUE', 'NOT TRUE');
        var sharePct = s * 100;
        q('[data-pt-share]').textContent = (sharePct < 0.1 ? sharePct.toFixed(2) : sharePct < 99.9 ? sharePct.toFixed(1) : Math.min(99.999, sharePct).toFixed(3)) + '%';
        q('[data-pt-sharebar]').style.width = Math.min(100, sharePct) + '%';
        q('[data-pt-mode]').textContent = standardise ? 'STANDARDISED' : 'RAW COORDINATES';

        // darts: the cluster's distance from the bullseye is the angle to the true weights,
        // its spread is how much restarts disagree
        var theta = Math.acos(Math.min(1, align));
        var r = 92 * theta / (Math.PI / 2);
        var ang = -0.75; // up and to the right
        var cx = r * Math.cos(ang), cy = r * Math.sin(ang);
        var spread = 4 + 70 * (1 - agree);
        darts.forEach(function (d) {
          var dx = Number(d.dataset.dx), dy = Number(d.dataset.dy);
          d.setAttribute('cx', (cx + dx * spread).toFixed(1));
          d.setAttribute('cy', (cy + dy * spread).toFixed(1));
        });

        var v = q('[data-pt-verdict]');
        if (!standardise) {
          v.innerHTML = 'Without standardisation the near-constant coordinate never takes more than <b>0.04%</b> of the direction, at any gain. The fit stays on target.';
        } else if (align >= 0.95) {
          v.innerHTML = 'A healthy layer: the restarts land on the true weights and agree. <b>Precise and true.</b> Now drag the gain toward zero.';
        } else if (agree < 0.9) {
          v.innerHTML = 'Midway: the direction is sliding onto the shrinking coordinate, and the restarts scatter as it goes.';
        } else {
          v.innerHTML = 'Accuracy passes. Restarts agree. <span class="warn">The direction is ' + Math.min(99.999, s * 100).toFixed(s > 0.999 ? 3 : 1) + '% on one coordinate the model barely reads</span>, so it misses the weights. <b>Precise, not true.</b>';
        }
      }

      range.addEventListener('input', update);
      stdBtn.addEventListener('click', function () {
        standardise = !standardise;
        stdBtn.setAttribute('aria-pressed', standardise ? 'true' : 'false');
        stdBtn.textContent = 'Standardise coordinates: ' + (standardise ? 'ON' : 'OFF');
        update();
      });
      update();
      // shrink the gain to 10^-5 and watch the direction collapse while every
      // check still passes; then switch standardisation off and watch it hold
      var at = 0, hold = 0, phase = 0;
      autoplay(root as HTMLElement, function () {
        if (hold > 0) { hold--; return; }
        if (phase === 0) {
          if (!standardise) stdBtn.click();
          at = Math.min(50, at + 1); range.value = String(at); update();
          if (at >= 50) { phase = 1; hold = 14; }
        } else if (phase === 1) { stdBtn.click(); phase = 2; hold = 22; }
        else { stdBtn.click(); at = 0; range.value = '0'; update(); phase = 0; hold = 8; }
      }, 140);
    } catch (e) { /* noop */ }
  })();

  /* ===================== 03 · localization: real vs random ===================== */
  (function () {
    'use strict';
    try {
      var root = document.querySelector('[data-instrument]');
      if (!root) return;
      var cells = Array.prototype.slice.call(root.querySelectorAll('[data-cell]')) as HTMLElement[];
      var btns = Array.prototype.slice.call(root.querySelectorAll('[data-heat-mode]')) as HTMLElement[];
      var verdict = root.querySelector('[data-heat-verdict]') as HTMLElement;
      var MSG: Record<string, string> = {
        real: 'The concept vector looks like it works: <b>97%</b> in the filed cell. Now switch to random vectors.',
        random: 'Random directions carry no concept, and still reach <b>92%</b> in the same cell. The readout registers that <i>something</i> was injected.',
        gap: 'What the concept adds is the difference: about <b>4 points</b> in the filed cell, near zero in most others. Hatched cells are where random did as well or better.',
      };
      function show(mode: string) {
        cells.forEach(function (c) {
          var real = Number(c.dataset.real), rnd = Number(c.dataset.random);
          var v = mode === 'real' ? real : mode === 'random' ? rnd : real - rnd;
          var b = c.querySelector('[data-cell-v]') as HTMLElement;
          if (mode === 'gap') {
            var pts = Math.round(v * 100);
            b.textContent = (pts > 0 ? '+' : pts < 0 ? '−' : '±') + Math.abs(pts);
            c.style.setProperty('--v', String(Math.max(0, Math.min(1, v / 0.3))));
            c.classList.toggle('is-neg', v <= 0);
            c.classList.toggle('is-dark', v / 0.3 > 0.55);
          } else {
            b.textContent = Math.round(v * 100) + '%';
            c.style.setProperty('--v', String(v));
            c.classList.remove('is-neg');
            c.classList.toggle('is-dark', v > 0.55);
          }
        });
        btns.forEach(function (b) {
          var on = b.dataset.heatMode === mode;
          b.classList.toggle('is-on', on);
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        verdict.innerHTML = MSG[mode];
      }
      btns.forEach(function (b) { b.addEventListener('click', function () { show(b.dataset.heatMode || 'real'); }); });
      // concept vectors, then random ones of the same norm, then the difference
      var hi = 0;
      autoplay(root as HTMLElement, function () { hi = (hi + 1) % btns.length; btns[hi].click(); }, 3200);
      show('real');
    } catch (e) { /* noop */ }
  })();

  /* ===================== 04 · capture–recapture simulator ===================== */
  (function () {
    'use strict';
    try {
      var root = document.querySelector('[data-mm]') as HTMLElement;
      if (!root) return;
      var N = root.querySelectorAll('[data-mm-freq]').length;
      var KMAX = root.querySelectorAll('[data-mm-runlab]').length;
      var q = function (s: string) { return root.querySelector(s) as HTMLElement; };

      function mulberry32(a: number) {
        return function () {
          a |= 0; a = (a + 0x6d2b79f5) | 0;
          var t = Math.imul(a ^ (a >>> 15), 1 | a);
          t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        };
      }
      var seed = 20261022;
      var rand = mulberry32(seed);
      var p: number[] = [];
      var hist: number[][] = []; // hist[run][item] = 0/1
      var order: number[] = []; // items in order of first discovery
      var revealed = false;

      function gauss() {
        var u = 1 - rand(), v = rand();
        return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
      }
      function newWorld() {
        rand = mulberry32(seed++);
        // uneven detectability: logit-normal, mean findability about 0.18
        p = [];
        for (var i = 0; i < N; i++) {
          var z = -1.9 + 1.6 * gauss();
          p.push(1 / (1 + Math.exp(-z)));
        }
        hist = []; order = [];
        render();
      }
      function runOnce() {
        if (hist.length >= KMAX) return;
        var row: number[] = [];
        for (var i = 0; i < N; i++) {
          var hit = rand() < p[i] ? 1 : 0;
          row.push(hit);
          if (hit && order.indexOf(i) < 0) order.push(i);
        }
        hist.push(row);
        render();
      }

      function stats() {
        var K = hist.length;
        var freq: number[] = [];
        for (var i = 0; i < N; i++) {
          var f = 0;
          for (var r = 0; r < K; r++) f += hist[r][i];
          freq.push(f);
        }
        var S = 0, Q1 = 0, Q2 = 0, U = 0;
        freq.forEach(function (f) { if (f > 0) S++; if (f === 1) Q1++; if (f === 2) Q2++; U += f; });
        var res: Record<string, number> = { K: K, S: S, Q1: Q1, Q2: Q2, U: U };
        // true coverage: share of total detection mass held by items already found
        var tot = 0, got = 0;
        p.forEach(function (pi, i) { tot += pi; if (freq[i] > 0) got += pi; });
        res.Ctrue = got / tot;
        if (K >= 2 && U > 0) {
          var a = K - 1;
          var term = Q2 > 0 ? (a * Q1) / (a * Q1 + 2 * Q2) : Q1 > 0 ? (a * (Q1 - 1)) / (a * (Q1 - 1) + 2) : 0;
          res.Chat = 1 - (Q1 / U) * term; // Chao–Jost incidence coverage
          var Q0 = Q2 > 0 ? (a / K) * (Q1 * Q1) / (2 * Q2) : (a / K) * (Q1 * (Q1 - 1)) / 2;
          res.chao2 = S + Q0; // bias-corrected Chao2 when Q2 = 0
          var m = K;
          res.dhat = Q0 > 0 ? Q0 * (1 - Math.pow(1 - Q1 / (K * Q0 + Q1), m)) : 0;
          var dtrue = 0;
          p.forEach(function (pi, i) { if (freq[i] === 0) dtrue += 1 - Math.pow(1 - pi, m); });
          res.dtrue = dtrue;
        }
        return { res: res, freq: freq };
      }

      function render() {
        var st = stats(), s = st.res, freq = st.freq;
        var K = s.K;
        // columns are failure modes in order of discovery; unfound ones fill the right-hand side
        var cols = order.slice();
        for (var i = 0; i < N; i++) if (cols.indexOf(i) < 0) cols.push(i);
        for (var c = 0; c < N; c++) {
          var item = cols[c];
          var f = freq[item];
          var fEl = q('[data-mm-freq="' + c + '"]');
          fEl.textContent = f > 0 ? String(f) : revealed ? '·' : '';
          fEl.classList.toggle('is-single', f === 1);
          for (var r = 0; r < KMAX; r++) {
            var cell = q('[data-mm-c="' + r + '-' + c + '"]');
            var ran = r < K;
            var hit = ran && hist[r][item] === 1;
            cell.classList.toggle('is-hit', hit);
            cell.classList.toggle('is-single', hit && f === 1);
            cell.classList.toggle('is-miss', ran && !hit);
          }
          var pEl = q('[data-mm-p="' + c + '"]');
          (pEl.firstElementChild as HTMLElement).style.height = Math.round(Math.min(1, p[item]) * 100) + '%';
          pEl.classList.toggle('is-missed', f === 0);
        }
        for (var rr = 0; rr < KMAX; rr++) q('[data-mm-runlab="' + rr + '"]').classList.toggle('is-live', rr < K);

        q('[data-mm-k]').textContent = String(K);
        q('[data-mm-s]').textContent = String(s.S);
        q('[data-mm-q1]').textContent = String(s.Q1);
        q('[data-mm-m]').textContent = K >= 2 ? String(K) : 'K';
        var have = s.Chat !== undefined;
        q('[data-mm-chat]').textContent = have ? s.Chat.toFixed(2) : '—';
        q('[data-mm-ctrue]').textContent = K > 0 ? s.Ctrue.toFixed(2) : '—';
        q('[data-mm-cbar]').style.width = have ? Math.round(s.Chat * 100) + '%' : '0';
        q('[data-mm-tbar]').style.left = K > 0 ? s.Ctrue * 100 + '%' : '0';
        q('[data-mm-chao]').textContent = have ? '≥ ' + Math.round(s.chao2) : '—';
        q('[data-mm-nbar]').style.width = have ? Math.min(100, (s.chao2 / N) * 100) + '%' : '0';
        q('[data-mm-dhat]').textContent = have ? s.dhat.toFixed(1) : '—';
        q('[data-mm-dtrue]').textContent = have ? s.dtrue.toFixed(1) : '—';

        var v = q('[data-mm-verdict]');
        if (K === 0) v.innerHTML = 'Run the audit. Each run finds each failure mode with its own probability.';
        else if (K === 1) v.innerHTML = 'One run found <b>' + s.S + '</b>. On its own that number says nothing about what was missed. Run another.';
        else if (K >= KMAX) v.innerHTML = 'Twelve runs. Coverage estimate <b>' + s.Chat.toFixed(2) + '</b> against a true <b>' + s.Ctrue.toFixed(2) + '</b>. The count bound says ≥ ' + Math.round(s.chao2) + ' of ' + N + ': <span class="warn">the hard-to-find failures are what it can’t see.</span> Show what was missed.';
        else v.innerHTML = 'Found <b>' + s.S + '</b>, ' + s.Q1 + ' of them by one run only. More single finds mean more left to find. Estimated coverage <b>' + s.Chat.toFixed(2) + '</b>; the true value is ' + s.Ctrue.toFixed(2) + '.';
      }

      q('[data-mm-run]').addEventListener('click', runOnce);
      q('[data-mm-run5]').addEventListener('click', function () { for (var i = 0; i < 5; i++) runOnce(); });
      q('[data-mm-new]').addEventListener('click', newWorld);
      var rv = q('[data-mm-reveal]');
      rv.addEventListener('click', function () {
        revealed = !revealed;
        root.classList.toggle('is-revealed', revealed);
        rv.setAttribute('aria-pressed', revealed ? 'true' : 'false');
        rv.textContent = revealed ? 'Hide findability' : 'Show what was missed';
        render();
      });
      newWorld();
      // twelve audits, then what they missed, then a new model
      var wait = 0;
      autoplay(root, function () {
        if (wait > 0) { wait--; return; }
        if (hist.length < KMAX) { if (revealed) rv.click(); runOnce(); if (hist.length >= KMAX) wait = 2; }
        else if (!revealed) { rv.click(); wait = 5; }
        else { rv.click(); newWorld(); wait = 1; }
      }, 850);
    } catch (e) { /* noop */ }
  })();
</script>
