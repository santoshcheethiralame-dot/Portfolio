---
import { site } from '../data/site';
---

<!-- HERO (sticky; edition rises over it) -->
<header class="me-top" id="top">
  <div class="hero-panel">
    <div class="hp-bar">
      <span class="hp-pill">PORTFOLIO '26</span>
      <span class="hp-meta">{site.location}</span>
      <span class="hp-meta hp-avail"><i class="dot" aria-hidden="true"></i>{site.availability}</span>
      <span class="hp-meta hp-clock" id="clock-time">—</span>
    </div>

    <div class="hp-stage">
      <!-- LEFT: big name + folded teaser -->
      <div class="hp-left">
        <h1 class="hp-name" aria-label={`${site.name.first} ${site.name.last}`}>
          <span class="hero-name">{site.name.first}</span>
          <span class="hero-name is-out" aria-hidden="true">{site.name.last}</span>
        </h1>

        <!-- FOLDED TEASER — the about shortcut -->
        <div class="teaser-wrap">
          <figure class="teaser" id="teaser" role="button" tabindex="0" aria-label="Read today's edition">
            <span class="ts-stamp" aria-hidden="true"><span id="ts-edition">LATE EDITION</span><br /><span class="b">&#9658;</span> BREAKING</span>

            <div class="ts-folio">
              <span>VOL. PES1UG24CS127</span>
              <span>PRICE: ONE FILTER COFFEE</span>
            </div>
            <hr class="ts-rule" />
            <div class="ts-mast">THE DAILY CHEETHIRALA</div>
            <div class="ts-dateline">
              <span class="dl-tag">BENGALURU</span><span>&middot;</span>
              <span id="ts-dl-date">&mdash;</span><span>&middot;</span>
              <span id="ts-dl-time">&mdash;</span>
            </div>

            <div class="ts-lead">
              <span class="ts-kicker">&#9654; FRONT PAGE &middot; BENGALURU BUREAU</span>
              <h2 class="ts-head" id="ts-head">THE INTERESTING WORK IS INSIDE THE BOX EVERYONE ELSE LEAVES SEALED</h2>
              <p class="ts-deck">I open black boxes &mdash; neural nets, version control, whatever&rsquo;s opaque.</p>
            </div>

            <ul class="ts-inside" aria-hidden="true">
              <li class="ih">// INSIDE TODAY</li>
              <li class="row"><span>The throughline</span><span class="dots"></span><span class="pg">p.1</span></li>
              <li class="row"><span>House rules &amp; stderr</span><span class="dots"></span><span class="pg">p.2</span></li>
              <li class="row"><span>Orbit &middot; GlassBox &middot; git-in-C</span><span class="dots"></span><span class="pg">p.3</span></li>
              <li class="row"><span>Interning now &middot; open summer &rsquo;27</span><span class="dots"></span><span class="pg">p.4</span></li>
            </ul>

            <div class="ts-foldzone">
              <div class="crease" aria-hidden="true"></div>
              <div class="ts-under" aria-hidden="true">
                <p>i spent more time planning to study than actually studying. orbit started as the fix &mdash; a planner that thinks in forgetting curves.</p>
                <p>i wrote a neural net by hand in the browser, backprop and all. a black box is just a system nobody&rsquo;s opened yet.</p>
              </div>
            </div>

            <div class="ts-hint">
              <span class="tri" aria-hidden="true">&#9658;</span>
              <span>TODAY&rsquo;S EDITION</span>
              <span class="arrow" aria-hidden="true">&darr;</span>
            </div>
          </figure>
        </div>
      </div>

      <!-- RIGHT: the portrait. A loupe follows the cursor and reads the pixel under
           it; the coffee steams; stderr blinks, slowly if you hover him. -->
      <div class="hp-side">
        <div class="hp-photo" id="hp-photo">
          <div class="pt-art" id="hp-pt-art">
            <img
              class="hp-portrait"
              src="/img/portrait.webp"
              width="1611"
              height="2000"
              fetchpriority="high"
              decoding="async"
              alt="Pixel-art portrait of Santosh holding a steel tumbler of filter coffee, a black cat on his shoulder"
            />
            <canvas class="pt-fx" id="hp-pt-fx" aria-hidden="true"></canvas>
          </div>
          <canvas class="pt-loupe" id="hp-pt-loupe" aria-hidden="true"></canvas>
          <div class="cat-scan" aria-hidden="true"></div>
          <span class="hp-photo-tag" id="hp-cat-tag" data-decode="[ it me ]">[ it me ]</span>
          <span class="hp-photo-hint" aria-hidden="true">hover · look closer</span>
        </div>
      </div>
    </div>

    <div class="hp-marquee" aria-hidden="true">
      <div class="mq-track">
        <span>LOCAL-FIRST TOOLS   ✱   TRANSPARENT ML   ✱   GPU KERNELS IN THE BROWSER   ✱   THE INTERNALS OF GPT-2   ✱   GIT REBUILT IN C   ✱  LOCAL-FIRST TOOLS   ✱   TRANSPARENT ML   ✱   GPU KERNELS IN THE BROWSER   ✱   THE INTERNALS OF GPT-2   ✱   GIT REBUILT IN C   ✱  </span>
        <span aria-hidden="true">LOCAL-FIRST TOOLS   ✱   TRANSPARENT ML   ✱   GPU KERNELS IN THE BROWSER   ✱   THE INTERNALS OF GPT-2   ✱   GIT REBUILT IN C   ✱  LOCAL-FIRST TOOLS   ✱   TRANSPARENT ML   ✱   GPU KERNELS IN THE BROWSER   ✱   THE INTERNALS OF GPT-2   ✱   GIT REBUILT IN C   ✱  </span>
      </div>
    </div>
  </div>
</header>

<style>
  /* ============================================================ HERO (.me-top) — fully scoped */
  /* STICKY hero: the edition sheet rises over it via native scroll, no JS. */
  .me-top {
    --bink: #141414;
    --bcream: #f7f5f1;
    --bcream2: #efece4;
    --bred: #ed1c24;
    --blime: #b4ff2e;
    --bgray: #928b80;
    position: sticky;
    top: 0;
    z-index: 0;
    width: 100%;
    height: 100svh;
    background: var(--bred);
    padding: clamp(10px, 1.4vw, 20px);
    display: flex;
    flex-direction: column;
    cursor: auto; /* native cursor restored — no probe */
  }

  .hero-panel {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    background: var(--bcream);
    background-image: var(--press-grain); /* same paper stock as the edition */
    border: 4px solid var(--bink);
    box-shadow: 10px 10px 0 var(--bink);
    overflow: hidden;
  }

  /* ── TOP BAR ── */
  .hp-bar {
    display: flex;
    align-items: center;
    gap: clamp(12px, 2vw, 26px);
    flex-wrap: wrap;
    min-height: 56px;
    padding: 8px clamp(16px, 2.4vw, 30px);
    border-bottom: 3px solid var(--bink);
    font-family: "Martian Mono", monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--bink);
  }
  .hp-pill {
    background: var(--bink);
    color: var(--bcream);
    padding: 4px 10px;
  }
  .hp-meta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .hp-clock {
    /* the clock reprints every second — fixed-width digit cells so the
       surrounding meta row doesn't twitch as the numerals change */
    font-variant-numeric: tabular-nums;
  }
  .hp-avail .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--bink);
    box-shadow: 0 0 0 2px var(--bink);
    /* idle-animation diet: static dot — the marquee is this viewport's one motion */
  }

  /* ── STAGE ── */
  .hp-stage {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: 1.33fr 1fr;
    /* hard gutter: the name/card column never touches the photo */
    gap: clamp(18px, 2.6vw, 40px);
    padding: clamp(16px, 2.2vw, 32px) clamp(16px, 2.6vw, 34px);
  }
  .hp-left {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    min-width: 0;
    /* let the column shrink to its grid track so the teaser can't overflow
       down into the marquee (it was overlapping the marquee band by ~35px) */
    min-height: 0;
  }
  .hp-name {
    min-width: 0;
  }
  .hero-name {
    display: block; /* spans inside the single h1 — each name line stays a block */
    font-family: "Press Display", sans-serif;
    font-weight: 500;
    /* FIX: clamp max reduced + wrapping allowed so CHEETHIRALA never runs under the cat */
    font-size: clamp(2.4rem, 11.5vw, 8.6rem);
    line-height: 0.82;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    color: var(--bink);
    white-space: normal;
    word-break: break-word;
  }
  /* the surname is the printing plate: an ink outline whose FILL develops as
     the edition rises over it (--plate-ink 0->1, driven by the hero engine).
     SANTOSH CHEETHIRALA inks up, then prints THE DAILY CHEETHIRALA. */
  .hero-name.is-out {
    color: transparent; /* fallback where color-mix is unsupported */
    color: color-mix(in srgb, var(--bink) calc(var(--plate-ink, 0) * 100%), transparent);
    -webkit-text-stroke: 2px var(--bink);
  }
  /* decode-in cells (written by the wordmark script) — the outline line resolves from ciphertext */
  .hero-name .dc {
    display: inline-block;
  }
  .hero-name.is-out .dc.scr {
    -webkit-text-stroke: 2px var(--blime);
    color: transparent;
  }
  /* .dc.on sets only the stroke, so each cell inherits the developing fill */
  .hero-name.is-out .dc.on {
    -webkit-text-stroke: 2px var(--bink);
    transition: -webkit-text-stroke-color 0.25s ease;
  }
  /* the platen thump — a tiny press-down the instant the plate is fully inked */
  .hero-name.is-out.plate-struck {
    animation: plate-strike 0.18s ease;
  }
  @keyframes plate-strike {
    45% { transform: translateY(2px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-name.is-out.plate-struck { animation: none; }
  }

  /* ============================================================ FOLDED TEASER — the about shortcut */
  .teaser-wrap {
    margin-top: clamp(14px, 1.8vw, 26px);
    /* clear of the marquee band below */
    margin-bottom: clamp(14px, 1.8vw, 24px);
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: stretch;
  }
  .teaser {
    position: relative;
    width: 100%;
    /* fill the left column (width + height) — no narrow cap; this kills the void below the name */
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--bcream);
    border: 2.5px solid var(--bink);
    box-shadow: 8px 8px 0 var(--bink);
    padding: clamp(12px, 1.3vw, 20px) clamp(14px, 1.5vw, 22px) clamp(12px, 1.3vw, 18px);
    cursor: pointer;
    /* ONE allowed micro-interaction: hover lift; no looping animation */
    transition: transform 0.14s ease, box-shadow 0.14s ease;
    outline: none;
  }
  /* small stack of papers underneath — hard edged, no animation */
  .teaser::before,
  .teaser::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--bcream2);
    border: 2.5px solid var(--bink);
    z-index: -1;
  }
  .teaser::before {
    transform: translate(4px, 4px);
  }
  .teaser::after {
    transform: translate(8px, 8px);
    z-index: -2;
  }
  .teaser:hover {
    transform: translate(2px, 2px);
    box-shadow: 6px 6px 0 var(--bink);
  }
  .teaser:focus-visible {
    box-shadow: 8px 8px 0 var(--bink), 0 0 0 3px var(--bred);
  }

  /* shrunk LATE EDITION stamp — one accent, rotated, hard-edged */
  .teaser .ts-stamp {
    position: absolute;
    top: -13px;
    right: -11px;
    z-index: 6;
    font-family: "Martian Mono", monospace;
    font-size: 8px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: center;
    color: var(--bcream);
    background: var(--bred);
    border: 2px solid var(--bink);
    box-shadow: 3px 3px 0 var(--bink);
    padding: 4px 7px;
    transform: rotate(7deg);
  }
  .teaser .ts-stamp .b {
    color: var(--blime);
  }

  /* folio strip */
  .teaser .ts-folio {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 2px 10px;
    font-family: "Martian Mono", monospace;
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bgray);
    margin-bottom: 6px;
  }
  .teaser .ts-rule {
    border: none;
    border-top: 3px solid var(--bink);
    margin: 0 0 7px;
  }
  .teaser .ts-mast {
    font-family: "Press Display", sans-serif;
    font-weight: 500;
    font-size: clamp(1.8rem, 2.7vw, 2.7rem);
    line-height: 0.9;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--bink);
    text-align: center;
    margin-bottom: 8px;
  }
  .teaser .ts-dateline {
    background: var(--bink);
    color: var(--bcream);
    font-family: "Martian Mono", monospace;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 4px 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
    text-align: center;
  }
  .teaser .ts-dateline .dl-tag {
    color: var(--blime);
  }

  /* lead headline + one-line deck — the headline resolves from ciphertext on hover */
  .teaser .ts-lead {
    padding-top: 8px;
  }
  .teaser .ts-kicker {
    display: block;
    font-family: "Martian Mono", monospace;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bred);
    margin-bottom: 5px;
  }
  .teaser .ts-head {
    font-family: "Press Display", sans-serif;
    font-weight: 500;
    font-size: clamp(1.1rem, 1.65vw, 1.55rem);
    line-height: 1.04;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--bink);
    margin: 0;
  }
  .teaser .ts-head .dc {
    display: inline-block;
  }
  .teaser .ts-head .dc.scr {
    color: #c4302b;
  }
  .teaser .ts-head .dc.on {
    color: var(--bink);
    transition: color 0.2s ease;
  }
  .teaser .ts-deck {
    margin-top: 7px;
    font-family: "Fraunces", serif;
    font-style: italic;
    font-size: clamp(0.9rem, 1.1vw, 1.05rem);
    line-height: 1.22;
    color: var(--bink);
  }

  /* INSIDE TODAY — four dotted entries */
  .teaser .ts-inside {
    list-style: none;
    margin: 9px 0 0;
    padding-top: 7px;
    border-top: 1.5px solid rgba(20, 20, 20, 0.25);
  }
  .teaser .ts-inside .ih {
    font-family: "Martian Mono", monospace;
    font-size: 7.5px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--bgray);
    margin-bottom: 3px;
  }
  .teaser .ts-inside li.row {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-family: "Fraunces", serif;
    font-size: 0.86rem;
    color: var(--bink);
    padding: 1px 0;
  }
  .teaser .ts-inside .dots {
    flex: 1;
    border-bottom: 1.5px dotted rgba(20, 20, 20, 0.4);
    transform: translateY(-3px);
  }
  .teaser .ts-inside .pg {
    font-family: "Martian Mono", monospace;
    font-size: 8.5px;
    font-weight: 700;
    color: var(--bink);
  }

  /* the fold: hard crease, then everything below tucked under (clip + cream→transparent mask) */
  .teaser .ts-foldzone {
    position: relative;
    flex: 1;
    min-height: 0;
    margin-top: 7px;
    display: flex;
    flex-direction: column;
  }
  .teaser .crease {
    flex: none;
    height: 9px;
    border-top: 1px solid rgba(20, 20, 20, 0.6);
    box-shadow: 0 -7px 9px -7px rgba(20, 20, 20, 0.4) inset,
      0 7px 9px -7px rgba(20, 20, 20, 0.22) inset;
  }
  .teaser .ts-under {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    margin-top: 3px;
    font-family: "Fraunces", serif;
    font-size: 0.74rem;
    line-height: 1.45;
    color: var(--bink);
    columns: 2;
    column-gap: 15px;
    column-rule: 1px solid rgba(20, 20, 20, 0.2);
    -webkit-mask-image: linear-gradient(180deg, #000 0, #000 14%, transparent 88%);
    mask-image: linear-gradient(180deg, #000 0, #000 14%, transparent 88%);
  }
  .teaser .ts-under p {
    margin: 0 0 0.5em;
  }

  /* hint row */
  .teaser .ts-hint {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: none;
    margin-top: 8px;
    font-family: "Martian Mono", monospace;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bred);
  }
  .teaser .ts-hint .tri {
    color: var(--blime);
    font-size: 11px;
    line-height: 1;
  }
  .teaser .ts-hint .arrow {
    margin-left: auto;
  }

  /* ── CAT SIDE ── */
  .hp-side {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: stretch;
    min-width: 0;
  }
  .hp-photo {
    flex: 1;
    width: 100%;
    min-height: 0;
    align-self: stretch;
    border: 6px solid var(--bink);
    box-shadow: 8px 8px 0 var(--bink);
    background: var(--bink);
    position: relative;
    overflow: hidden;
  }
  /* the art box is sized to cover the frame (container units read the frame),
     a touch oversized so the head-lean never shows an edge, and the steam/blink
     canvas shares it exactly, so both draw in the portrait's own pixel space */
  .hp-photo {
    container-type: size;
  }
  .pt-art {
    position: absolute;
    left: 50%;
    top: 50%;
    width: max(106cqw, calc(106cqh * 1611 / 2000));
    aspect-ratio: 1611 / 2000;
    translate: -50% -47%;
    will-change: transform;
  }
  .hp-portrait,
  .pt-fx {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .hp-portrait {
    image-rendering: pixelated;
    user-select: none;
    -webkit-user-drag: none;
  }
  .pt-fx {
    pointer-events: none;
  }
  .pt-loupe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 4;
    pointer-events: none;
  }
  .hp-photo.is-looking {
    cursor: none;
  }
  /* scanlines: normal blending at low alpha reads the same as multiply over this
     art and never asks any engine for a blend group over the animated canvases */
  .cat-scan {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    opacity: 0.06;
    background: repeating-linear-gradient(0deg, rgba(10, 10, 10, 0.6) 0 1px, transparent 1px 3px);
  }
  .hp-photo-hint {
    position: absolute;
    right: 12px;
    bottom: 10px;
    z-index: 10;
    font-family: var(--font-pixel);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bink);
    background: var(--blime);
    padding: 4px 7px 3px;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .hp-photo.is-looking .hp-photo-hint {
    opacity: 0;
    transform: translateY(6px);
  }
  .hp-photo-tag {
    position: absolute;
    bottom: 10px;
    left: 12px;
    font-family: "Martian Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bcream);
    background: var(--bink);
    padding: 4px 7px;
    z-index: 10;
  }

  /* ── MARQUEE ── */
  .hp-marquee {
    border-top: 3px solid var(--bink);
    background: var(--bink);
    overflow: hidden;
  }
  .mq-track {
    display: flex;
    width: max-content;
    animation: mq-scroll 46s linear infinite;
  }
  .mq-track span {
    white-space: nowrap;
    padding: 12px 0;
    font-family: "Press Display", sans-serif;
    font-weight: 500;
    font-size: clamp(1rem, 1.6vw, 1.45rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--bcream);
  }
  @keyframes mq-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mq-track {
      animation: none;
    }
  }

  /* HERO RESPONSIVE */
  @media (max-width: 820px) {
    .hp-stage {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .hero-name {
      font-size: clamp(2.2rem, 13vw, 6rem);
    }
    .hp-photo {
      min-height: 150px;
    }
    /* stacked column: teaser sizes to content, single-column tuck */
    .teaser-wrap {
      flex: none;
    }
    .teaser {
      height: auto;
      padding: 12px 14px;
    }
    .teaser .ts-foldzone {
      flex: none;
    }
    .teaser .ts-under {
      flex: none;
      height: 3.2em;
      columns: 1;
    }
  }
  @media (max-width: 600px) {
    /* collapse: masthead bar + hint only */
    .teaser .ts-folio,
    .teaser .ts-rule,
    .teaser .ts-dateline,
    .teaser .ts-lead,
    .teaser .ts-inside,
    .teaser .ts-foldzone,
    .teaser .ts-stamp {
      display: none;
    }
    .teaser .ts-mast {
      margin-bottom: 6px;
      text-align: left;
      font-size: 1.5rem;
    }
    .teaser .ts-hint {
      margin-top: 8px;
    }
    .teaser::before,
    .teaser::after {
      display: none;
    }
  }
</style>

<script>
  // HERO ENGINE: the portrait. A slow head-lean parallax; pixel steam off the coffee;
  // stderr blinks (a slow blink when you hover him, which is how cats say hello); and
  // a loupe that magnifies the art under the cursor and reads out the pixel there.
  // Fast moves split the loupe's colour plates apart like a press out of register;
  // they settle back into register when the cursor rests. The caption under the frame
  // names what you are over. The clock (#clock-time) is filled by main.ts.
  import { decode } from '../scripts/decode';

  (function () {
    'use strict';
    try {
      const photo = document.getElementById('hp-photo');
      const hero = document.querySelector<HTMLElement>('.me-top');
      const art = document.getElementById('hp-pt-art');
      const img = art?.querySelector<HTMLImageElement>('img');
      const fxCv = document.getElementById('hp-pt-fx');
      const lpCv = document.getElementById('hp-pt-loupe');
      const tag = document.getElementById('hp-cat-tag');
      if (!photo || !hero || !art || !img || !(fxCv instanceof HTMLCanvasElement) || !(lpCv instanceof HTMLCanvasElement)) return;
      const fx = fxCv.getContext('2d');
      const lp = lpCv.getContext('2d');
      if (!fx || !lp) return;

      const PRM = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const IW = 1611, IH = 2000; // the portrait's own pixel space
      const dpr = Math.min(2, window.devicePixelRatio || 1);

      /* regions of the art, in its own pixels */
      const EYES = [[1234, 1164, 1295, 1200], [1372, 1189, 1433, 1213]];
      const FUR = '#141412';
      const ZONES: [string, number[][]][] = [
        ['[ stderr · unimpressed ]', [[1180, 960, 1560, 1520], [230, 1020, 570, 1370]]],
        ['[ filter coffee · hot ]', [[760, 1540, 1210, 2000]]],
        ['[ it me ]', [[380, 230, 1220, 1330]]],
      ];
      const zoneAt = (x: number, y: number) => {
        for (const [label, boxes] of ZONES) for (const b of boxes) if (x >= b[0] && x <= b[2] && y >= b[1] && y <= b[3]) return label;
        return '[ it me ]';
      };

      /* ---------- sizing: both canvases track their boxes ---------- */
      let artW = 1, artH = 1, frW = 1, frH = 1, k = 1; // k = css px per art px
      function size() {
        const ar = art!.getBoundingClientRect(), fr = photo!.getBoundingClientRect();
        artW = ar.width; artH = ar.height; frW = fr.width; frH = fr.height; k = artW / IW;
        fxCv.width = Math.max(1, Math.round(artW * dpr)); fxCv.height = Math.max(1, Math.round(artH * dpr));
        lpCv.width = Math.max(1, Math.round(frW * dpr)); lpCv.height = Math.max(1, Math.round(frH * dpr));
        fx!.setTransform(dpr * k, 0, 0, dpr * k, 0, 0); // fx draws in art pixels
        lp!.setTransform(dpr, 0, 0, dpr, 0, 0);
        fxDirty = null; lpDirty = null;
      }

      /* ---------- the head-lean ---------- */
      const LEAN = 9;
      let tx = 0, ty = 0, cx = 0, cy = 0;

      /* ---------- steam: pixel puffs off the tumbler's rim ---------- */
      const PX = 12; // the art's own pixel size, near enough
      interface Puff { x: number; y: number; vy: number; ph: number; life: number; age: number; s: number; }
      const puffs: Puff[] = [];
      let puffClock = 0;
      function spawn() {
        puffs.push({ x: 930 + Math.random() * 100, y: 1560, vy: 34 + Math.random() * 26, ph: Math.random() * 6.28, life: 2.6 + Math.random() * 1.6, age: 0, s: Math.random() < 0.3 ? 2 : 1 });
      }

      /* ---------- the blink ---------- */
      let blinkT = 2.2, blinkP = 0, slow = false; // blinkP 0 open .. 1 shut
      let blinkPhase = 0; // seconds into the current blink, -1 when idle
      let blinking = false;

      let fxDirty: number[] | null = null;
      function grow(b: number[] | null, x0: number, y0: number, x1: number, y1: number) {
        if (!b) return [x0, y0, x1, y1];
        b[0] = Math.min(b[0], x0); b[1] = Math.min(b[1], y0); b[2] = Math.max(b[2], x1); b[3] = Math.max(b[3], y1);
        return b;
      }
      function drawFx(dt: number) {
        if (fxDirty) fx!.clearRect(fxDirty[0], fxDirty[1], fxDirty[2] - fxDirty[0], fxDirty[3] - fxDirty[1]);
        let d: number[] | null = null;
        if (!PRM) {
          puffClock += dt;
          while (puffClock > 0.16) { puffClock -= 0.16; if (puffs.length < 26) spawn(); }
          for (let i = puffs.length - 1; i >= 0; i--) {
            const p = puffs[i];
            p.age += dt; p.y -= p.vy * dt;
            if (p.age > p.life) { puffs.splice(i, 1); continue; }
            const t = p.age / p.life;
            const x = p.x + Math.sin(p.ph + p.age * 2.1) * (10 + t * 34);
            const a = (t < 0.15 ? t / 0.15 : 1 - (t - 0.15) / 0.85) * 0.55;
            const sz = PX * p.s;
            const gx = Math.round(x / PX) * PX, gy = Math.round(p.y / PX) * PX; // snap to the art's grid
            fx!.fillStyle = 'rgba(247,245,241,' + a.toFixed(3) + ')';
            fx!.fillRect(gx, gy, sz, sz);
            d = grow(d, gx - 1, gy - 1, gx + sz + 1, gy + sz + 1);
          }
          // blink scheduler
          if (!blinking) {
            blinkT -= dt;
            if (blinkT <= 0) { blinking = true; blinkPhase = 0; }
          }
          if (blinking) {
            const close = slow ? 0.42 : 0.07, hold = slow ? 0.5 : 0.06, open = slow ? 0.5 : 0.1;
            blinkPhase += dt;
            const ph = blinkPhase;
            blinkP = ph < close ? ph / close : ph < close + hold ? 1 : ph < close + hold + open ? 1 - (ph - close - hold) / open : 0;
            if (ph >= close + hold + open) { blinking = false; blinkP = 0; blinkT = slow ? 1.6 + Math.random() * 1.2 : 2.5 + Math.random() * 4; }
          }
          if (blinkP > 0) {
            fx!.fillStyle = FUR;
            for (const e of EYES) {
              const h = (e[3] - e[1] + 8) * blinkP;
              const yy = Math.round((e[1] - 4) / 4) * 4;
              fx!.fillRect(e[0] - 4, yy, e[2] - e[0] + 8, Math.ceil(h / 4) * 4);
              d = grow(d, e[0] - 6, e[1] - 6, e[2] + 6, e[3] + 6);
            }
          } else {
            // the lids just lifted: make sure last frame's lids are cleared
            if (fxDirty) for (const e of EYES) d = grow(d, e[0] - 6, e[1] - 6, e[2] + 6, e[3] + 6);
          }
        }
        fxDirty = d;
      }

      /* ---------- the loupe ---------- */
      // channel plates, built once (lazily) from a half-size copy of the art
      const HS = 2; // half size
      let plates: HTMLCanvasElement[] | null = null, px: Uint8ClampedArray | null = null, pw = 0, ph2 = 0;
      function buildPlates() {
        if (plates || !img!.complete || !img!.naturalWidth) return;
        try {
          pw = Math.round(IW / HS); ph2 = Math.round(IH / HS);
          const c = document.createElement('canvas'); c.width = pw; c.height = ph2;
          const g = c.getContext('2d', { willReadFrequently: true }); if (!g) return;
          g.imageSmoothingEnabled = false;
          g.drawImage(img!, 0, 0, pw, ph2);
          const src = g.getImageData(0, 0, pw, ph2);
          px = src.data;
          plates = [0, 1, 2].map((ch) => {
            const pc = document.createElement('canvas'); pc.width = pw; pc.height = ph2;
            const pg = pc.getContext('2d'); if (!pg) return pc;
            const out = pg.createImageData(pw, ph2), o = out.data, s = src.data;
            for (let i = 0; i < s.length; i += 4) { o[i + ch] = s[i + ch]; o[i + 3] = 255; }
            pg.putImageData(out, 0, 0);
            return pc;
          });
        } catch (e) { plates = null; }
      }
      let mx = -1, my = -1, inside = false, vx = 0, vy = 0, lmx = -1, lmy = -1, split = 0, sdx = 0, sdy = 0;
      let lpDirty: number[] | null = null;
      const R = 74, ZOOM = 2.6;
      function hex(n: number) { return n.toString(16).padStart(2, '0'); }
      function drawLoupe() {
        if (lpDirty) lp!.clearRect(lpDirty[0], lpDirty[1], lpDirty[2] - lpDirty[0], lpDirty[3] - lpDirty[1]);
        lpDirty = null;
        if (!inside || !plates) return;
        // where the cursor is in art pixels (the art box sits offset inside the frame)
        const ar = art!.getBoundingClientRect(), fr = photo!.getBoundingClientRect();
        const ox = ar.left - fr.left, oy = ar.top - fr.top;
        const ax = (mx - ox) / k, ay = (my - oy) / k;
        const srcR = R / (k * ZOOM); // radius in art px
        // velocity → plate split (settles to zero at rest)
        if (lmx >= 0 && !PRM) { vx = vx * 0.7 + (mx - lmx) * 0.3; vy = vy * 0.7 + (my - lmy) * 0.3; }
        lmx = mx; lmy = my;
        const sp = Math.min(9, Math.hypot(vx, vy) * 0.55);
        split += (sp - split) * 0.25;
        const vl = Math.hypot(vx, vy) || 1;
        sdx = (vx / vl) * split; sdy = (vy / vl) * split;
        lp!.save();
        lp!.beginPath(); lp!.arc(mx, my, R, 0, Math.PI * 2); lp!.clip();
        lp!.fillStyle = '#000'; lp!.fillRect(mx - R, my - R, R * 2, R * 2);
        lp!.imageSmoothingEnabled = false;
        lp!.globalCompositeOperation = 'lighter';
        const sx = (ax - srcR) / HS, sy = (ay - srcR) / HS, sw = (srcR * 2) / HS;
        const off = [[sdx, sdy], [0, 0], [-sdx, -sdy]];
        for (let c = 0; c < 3; c++) lp!.drawImage(plates[c], sx, sy, sw, sw, mx - R + off[c][0], my - R + off[c][1], R * 2, R * 2);
        lp!.globalCompositeOperation = 'source-over';
        lp!.restore();
        // ring, ticks, crosshair
        lp!.lineWidth = 3; lp!.strokeStyle = '#141414';
        lp!.beginPath(); lp!.arc(mx, my, R + 1.5, 0, Math.PI * 2); lp!.stroke();
        lp!.lineWidth = 1.5; lp!.strokeStyle = '#b4ff2e';
        lp!.beginPath(); lp!.arc(mx, my, R - 1, 0, Math.PI * 2); lp!.stroke();
        lp!.beginPath();
        for (let i = 0; i < 4; i++) { const a = i * Math.PI / 2; lp!.moveTo(mx + Math.cos(a) * (R - 9), my + Math.sin(a) * (R - 9)); lp!.lineTo(mx + Math.cos(a) * (R + 6), my + Math.sin(a) * (R + 6)); }
        lp!.moveTo(mx - 6, my); lp!.lineTo(mx + 6, my); lp!.moveTo(mx, my - 6); lp!.lineTo(mx, my + 6);
        lp!.stroke();
        // readout: the pixel under the crosshair
        let label = '';
        if (px) {
          const ix = Math.max(0, Math.min(pw - 1, Math.floor(ax / HS))), iy = Math.max(0, Math.min(ph2 - 1, Math.floor(ay / HS)));
          const i = (iy * pw + ix) * 4;
          label = 'x' + Math.round(ax) + ' y' + Math.round(ay) + '  #' + hex(px[i]) + hex(px[i + 1]) + hex(px[i + 2]);
          lp!.font = '700 10px "Martian Mono", monospace';
          const tw = lp!.measureText(label).width + 22;
          let bx = mx - tw / 2, by = my + R + 12;
          if (by + 20 > frH) by = my - R - 32;
          bx = Math.max(4, Math.min(frW - tw - 4, bx));
          lp!.fillStyle = '#141414'; lp!.fillRect(bx, by, tw, 20);
          lp!.fillStyle = 'rgb(' + px[i] + ',' + px[i + 1] + ',' + px[i + 2] + ')'; lp!.fillRect(bx + 6, by + 6, 8, 8);
          lp!.fillStyle = '#f7f5f1'; lp!.textBaseline = 'middle'; lp!.fillText(label, bx + 18, by + 10.5);
          lpDirty = grow(lpDirty, bx - 2, by - 2, bx + tw + 2, by + 22);
        }
        lpDirty = grow(lpDirty, mx - R - 12, my - R - 12, mx + R + 12, my + R + 12);
        // caption follows what's under the loupe
        const z = zoneAt(ax, ay);
        if (z !== zone) { zone = z; if (tag) decode(tag as HTMLElement, z, { dur: 380 }); }
        const nowSlow = z.indexOf('stderr') >= 0;
        if (nowSlow && !slow && !blinking) blinkT = Math.min(blinkT, 0.35);
        slow = nowSlow;
      }
      let zone = '[ it me ]';

      photo.addEventListener('pointerenter', () => { buildPlates(); });
      photo.addEventListener('pointermove', (e) => {
        const r = photo.getBoundingClientRect();
        mx = e.clientX - r.left; my = e.clientY - r.top;
        if (!inside) { inside = true; lmx = -1; photo.classList.add('is-looking'); buildPlates(); }
        startLoop();
      });
      photo.addEventListener('pointerleave', () => {
        inside = false; slow = false; photo.classList.remove('is-looking');
        if (zone !== '[ it me ]') { zone = '[ it me ]'; if (tag) decode(tag as HTMLElement, zone, { dur: 380 }); }
      });
      hero.addEventListener('pointermove', function (e) {
        const r = photo.getBoundingClientRect();
        const nx = ((e.clientX - r.left) / r.width - 0.5) * 2;
        const ny = ((e.clientY - r.top) / r.height - 0.5) * 2;
        tx = Math.max(-1, Math.min(1, nx)) * LEAN;
        ty = Math.max(-1, Math.min(1, ny)) * LEAN * 0.7;
      });
      hero.addEventListener('pointerleave', function () { tx = 0; ty = 0; });

      /* rAF loop — runs only while the hero can actually be seen. Two flags:
         the sticky hero "intersecting" even while the edition sheet covers it,
         so a second observer watches whether the edition spans the viewport's
         top edge (rootMargin bottom -100% reduces the root to that top line). */
      let heroInView = true, editionCoversTop = false, rafOn = false;
      const mqTrack = hero.querySelector<HTMLElement>('.mq-track');
      function running() { return heroInView && !editionCoversTop; }
      function reflectMarquee() {
        // the IO-based pause in main.ts can't see the edition occluding the
        // sticky hero — reuse the engine's visibility flags for the marquee too
        if (mqTrack) mqTrack.classList.toggle('mq-offstage', !running());
      }

      /* plate impression: the outline surname fills with ink as the rising
         edition closes on it, hitting solid right as the press covers it */
      const surname = document.querySelector<HTMLElement>('.me-top .hero-name.is-out');
      const editionEl = document.getElementById('about');
      let lastInk = 0;
      function inkPlate() {
        if (PRM || !surname || !editionEl) return;
        const nr = surname.getBoundingClientRect();
        if (nr.height < 1) return;
        const lead = window.innerHeight * 0.55;
        const startTop = nr.bottom + lead; // editionTop where inking begins (p=0)
        const endTop = nr.top;             // editionTop where the plate is solid (p=1)
        const editionTop = editionEl.getBoundingClientRect().top;
        const p = Math.max(0, Math.min(1, (startTop - editionTop) / (startTop - endTop)));
        if (Math.abs(p - lastInk) > 0.0005 || (p === 0) !== (lastInk === 0)) surname.style.setProperty('--plate-ink', p.toFixed(3));
        if (p >= 0.985 && lastInk < 0.985) {
          surname.classList.remove('plate-struck');
          void surname.offsetWidth; // restart the one-shot thump
          surname.classList.add('plate-struck');
        }
        lastInk = p;
      }

      let lastT = 0, lastArt = '';
      function loop(now: number) {
        if (!running()) { rafOn = false; return; }
        const dt = lastT ? Math.max(0, Math.min(0.05, (now - lastT) / 1000)) : 0;
        lastT = now;
        if (!(window as any).__pressFreeze) { // STOP THE PRESS holds everything mid-air
          inkPlate();
          cx += (tx - cx) * 0.12;
          cy += (ty - cy) * 0.12;
          const t = PRM ? '' : 'translate(' + cx.toFixed(1) + 'px,' + cy.toFixed(1) + 'px)';
          if (t !== lastArt) { lastArt = t; art!.style.transform = t; }
          drawFx(dt);
          drawLoupe();
        }
        requestAnimationFrame(loop);
      }
      function startLoop() {
        if (!rafOn && running()) { rafOn = true; lastT = 0; requestAnimationFrame(loop); }
      }
      if (typeof IntersectionObserver !== 'undefined') {
        new IntersectionObserver(function (es) {
          es.forEach(function (en) { heroInView = en.isIntersecting; });
          startLoop();
          reflectMarquee();
        }).observe(hero);
        if (editionEl) {
          new IntersectionObserver(function (es) {
            es.forEach(function (en) { editionCoversTop = en.isIntersecting; });
            startLoop();
            reflectMarquee();
          }, { rootMargin: '0px 0px -100% 0px' }).observe(editionEl);
        }
      }

      size();
      if (typeof ResizeObserver !== 'undefined') new ResizeObserver(size).observe(photo);
      else window.addEventListener('resize', size);
      /* decode the [ it me ] tag via the shared house cipher */
      if (tag) decode(tag as HTMLElement, null, { dur: 700 });
      startLoop();
    } catch (e) { /* hero engine failed silently */ }
  })();
</script>

<script>
  // TEASER SHORTCUT: click or Enter/Space scrolls in-page to #about.
  (function () {
    'use strict';
    try {
      const teaser = document.getElementById('teaser');
      if (!teaser) return;

      function jump() {
        try {
          const lenis = (window as unknown as { __lenis?: { scrollTo: (t: string, o?: unknown) => void } }).__lenis;
          if (lenis) {
            lenis.scrollTo('#about', { offset: 0 });
          } else {
            document.getElementById('about')?.scrollIntoView({ behavior: 'smooth' });
          }
        } catch (e) {
          document.getElementById('about')?.scrollIntoView({ behavior: 'smooth' });
        }
      }

      teaser.addEventListener('click', jump);
      teaser.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); jump(); }
      });
    } catch (e) { /* teaser shortcut failed silently */ }
  })();
</script>

<script>
  // THE NAME: justified two-line wordmark (each line fit to the column width, so the
  //   longer surname ends up smaller per-letter and both edges line up) + the outline
  //   surname develops from ciphertext on load.
  // THE CHRONICLE: live IST dateline + a lead headline that resolves from ciphertext on
  //   hover — the same decode the edition completes when it prints over.
  (function () {
    'use strict';
    try {
      const PRM = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const GLYPHS = 'ABCDEFGHJKLMNPQRSTUVWXYZ0123456789#/<>[]{}*+=·.@%&';
      const rg = () => GLYPHS[(Math.random() * GLYPHS.length) | 0];

      /* shared decode: scramble → resolve, left to right */
      function decode(el: HTMLElement, text: string, stagger: number, scr: number) {
        if (PRM) { el.textContent = text; return; }
        const spans = text.split('').map((ch) => {
          const s = document.createElement('span');
          s.className = 'dc';
          if (ch === ' ') { s.innerHTML = '&nbsp;'; s.dataset.sp = '1'; }
          else { s.textContent = rg(); s.classList.add('scr'); }
          s.dataset.ch = ch;
          return s;
        });
        el.textContent = '';
        spans.forEach((s) => el.appendChild(s));
        const start = performance.now();
        let bucket = -1;
        const tick = (now: number) => {
          const b = (now / 48) | 0;
          const swap = b !== bucket;
          bucket = b;
          let done = true;
          spans.forEach((s, i) => {
            if (s.dataset.sp) return;
            const begin = start + i * stagger;
            if (now >= begin + scr) {
              if (!s.dataset.on) {
                s.dataset.on = '1';
                s.textContent = s.dataset.ch || '';
                s.classList.remove('scr');
                s.classList.add('on');
              }
            } else {
              done = false;
              if (now >= begin && swap) s.textContent = rg();
            }
          });
          if (!done) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }

      /* stable ciphertext at rest (looks encrypted, not noise) */
      function cipher(el: HTMLElement, text: string) {
        el.textContent = '';
        text.split('').forEach((ch, i) => {
          const s = document.createElement('span');
          s.className = 'dc';
          if (ch === ' ') { s.innerHTML = '&nbsp;'; }
          else { s.textContent = GLYPHS[((i * 29 + 13) >>> 0) % GLYPHS.length]; s.classList.add('scr'); }
          el.appendChild(s);
        });
      }

      /* ── THE NAME ── */
      const l1 = document.querySelector<HTMLElement>('.me-top .hero-name:not(.is-out)');
      const l2 = document.querySelector<HTMLElement>('.me-top .hero-name.is-out');
      const L1 = l1 ? (l1.textContent || '').trim() : '';
      const L2 = l2 ? (l2.textContent || '').trim() : '';
      let meas: HTMLSpanElement | null = null;
      function textW(ref: HTMLElement, text: string) {
        if (!meas) {
          meas = document.createElement('span');
          meas.style.cssText = 'position:absolute;left:-99999px;top:0;white-space:nowrap;visibility:hidden;pointer-events:none;';
          document.body.appendChild(meas);
        }
        const cs = getComputedStyle(ref);
        meas.style.fontFamily = cs.fontFamily;
        meas.style.fontWeight = cs.fontWeight;
        meas.style.letterSpacing = cs.letterSpacing;
        meas.style.textTransform = 'uppercase';
        meas.style.fontSize = '100px';
        meas.textContent = text;
        return meas.offsetWidth;
      }
      function fit(el: HTMLElement, text: string, target: number) {
        el.style.whiteSpace = 'nowrap';
        const w = textW(el, text);
        if (w > 0) el.style.fontSize = (100 * target) / w + 'px';
      }
      function layoutName() {
        if (!l1 || !l2) return;
        const col = (l1.parentElement as HTMLElement).getBoundingClientRect().width;
        if (window.innerWidth <= 820 || col < 2) {
          l1.style.fontSize = ''; l2.style.fontSize = '';
          l1.style.whiteSpace = ''; l2.style.whiteSpace = '';
          l1.textContent = L1;
          return;
        }
        l1.textContent = L1;
        fit(l1, L1, col);
        fit(l2, L2, col); // measures via the hidden span — does NOT disturb l2's decode content
        // The hero is exactly one screen tall, and a width-fitted name on a short
        // screen (a laptop, or Safari with its taller toolbar) left the teaser too
        // little room: its last rows printed past the card's border. Only then, give
        // the name back exactly the overflow, so screens that already fit are untouched.
        const teaser = document.getElementById('teaser');
        const name = l1.parentElement as HTMLElement;
        if (teaser && name) {
          // the last row against the card's inner edge (scrollHeight would also count
          // the offset paper-stack pseudo-elements, which are meant to stick out)
          const last = teaser.lastElementChild as HTMLElement | null;
          const cs = getComputedStyle(teaser);
          const inner = teaser.getBoundingClientRect().bottom - parseFloat(cs.borderBottomWidth) - parseFloat(cs.paddingBottom);
          const over = last ? last.getBoundingClientRect().bottom - inner : 0;
          const nameH = name.getBoundingClientRect().height;
          if (over > 1 && nameH > 0) {
            const k = Math.max(0.35, (nameH - over - 2) / nameH);
            l1.style.fontSize = parseFloat(l1.style.fontSize) * k + 'px';
            l2.style.fontSize = parseFloat(l2.style.fontSize) * k + 'px';
          }
        }
      }
      function runName() { layoutName(); }
      // the wordmark cypher: HOLD until the page has actually revealed (main.ts removes
      // html.staging) — tying it to fonts.ready let it finish before first paint on a
      // slow bundle, so you only caught the last few letters. Then run it slow enough to
      // watch, on the now-free main thread (the cover-stack build is deferred to idle).
      let cyphered = false;
      function startCypher() {
        if (cyphered || !l2) return;
        cyphered = true;
        if (PRM) { l2.textContent = L2; return; }
        decode(l2, L2, 70, 560);
      }
      (function waitReveal(n: number) {
        if (!document.documentElement.classList.contains('staging') || n > 80) return startCypher();
        requestAnimationFrame(() => waitReveal(n + 1));
      })(0);
      window.addEventListener('resize', layoutName);

      /* ── THE CHRONICLE: the teaser headline stays plain + readable. Sitting in
         ciphertext (it only resolved on hover) read as a first-look glitch, so the
         cypher is gone — #ts-head already carries the real headline from the markup.
         Hovering the teaser plays ONE quick decode flourish, and never re-scrambles. ── */
      const head = document.getElementById('ts-head');
      const HTEXT = head ? (head.textContent || '').trim() : '';
      const teaser = document.getElementById('teaser');
      if (head && teaser && !PRM) {
        let played = false;
        const enter = () => { if (played) return; played = true; decode(head, HTEXT, 20, 280); };
        teaser.addEventListener('pointerenter', enter);
        teaser.addEventListener('focus', enter);
      }

      /* ── live IST dateline (BENGALURU · date · time) ── */
      const dEl = document.getElementById('ts-dl-date');
      const tEl = document.getElementById('ts-dl-time');
      if (dEl || tEl) {
        const fd = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Kolkata', weekday: 'short', month: 'short', day: 'numeric' });
        const ft = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Kolkata', hour: 'numeric', minute: '2-digit', hour12: true });
        const tickDL = () => {
          const now = new Date();
          if (dEl) dEl.textContent = fd.format(now).toUpperCase();
          if (tEl) tEl.textContent = ft.format(now).replace(' ', '');
        };
        tickDL();
        setInterval(tickDL, 15000);
      }

      /* ── the folded teaser's stamp tracks the same IST edition as the masthead ── */
      const edStamp = document.getElementById('ts-edition');
      if (edStamp) {
        let hr = 12;
        try { hr = parseInt(new Intl.DateTimeFormat('en-GB', { hour: '2-digit', hour12: false, timeZone: 'Asia/Kolkata' }).format(new Date()), 10); } catch (e) { /* keep midday */ }
        edStamp.textContent =
          hr >= 5 && hr < 11 ? 'MORNING EDITION'
          : hr >= 11 && hr < 16 ? 'MIDDAY EDITION'
          : hr >= 16 && hr < 21 ? 'EVENING EDITION'
          : 'LATE EDITION';
      }

      const docFonts = (document as unknown as { fonts?: { ready: Promise<unknown> } }).fonts;
      if (docFonts && docFonts.ready) docFonts.ready.then(runName);
      else runName();
      setTimeout(runName, 650);
    } catch (e) { /* name / chronicle enhancement failed silently */ }
  })();
</script>
